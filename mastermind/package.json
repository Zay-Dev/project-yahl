{
  "name": "@project-yahl/mastermind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "development": "./contract/index.ts",
      "import": "./dist/contract/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "tsx --test \"src/**/*.test.ts\" \"contract/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect-node": "^1.7.0",
    "@cursor/sdk": "^1.0.19",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
