name: competitor-intel
description: Competitor intelligence brief
resultContextKey: result

types: |
  type TIntelItem = {
    title: string;
    source_url: string;
    date: Date;
    competitor: string;
    category: 'product_launch' | 'pricing_change' | 'partnership' | 'funding' | 'other';
    sentiment: 'positive' | 'neutral' | 'negative';
    summary_zh: string;
  };

  type TBriefTakeaway = {
    text_zh: string;
  };

  type TBriefSection = {
    heading: string;
    body_md: string<Markdown>;
  };

  type TResult = {
    executive_summary_md: string<Markdown>;
    generated_at: string<Date>;
    raw_intel: TIntelItem[];
    sections: TBriefSection[];
    takeaways: TBriefTakeaway[];
    title: string;
  };

stages:
  - contextMode: true
    produceContextKeys: [competitors, intel]
    logic: |
      (() => ({
        competitors: [
          { name: 'TESLA', news_sources: ['yahoo news', 'bbc', 'reddit',] },
          { name: 'XiaoMi', news_sources: ['bloomberg', 'techinasia'] },
          { name: 'BYD', news_sources: ['yahoo news', 'bloomberg'] },
        ],
        intel: [],
      }))

  - loopSetup: for each competitor of [competitors]
    updateContextKeys: [intel]
    logic: |
      *tmp(~/uuid-article.txt) = /stagehand(
        search,
        competitor: competitor.name,
        sources: competitor.news_sources,
        all_sources_at_once,
        filter: business_relevant,
        max_results: 10,
      );

      EXTENDS: intel = *analyze(
        raw_articles,
        set_competitor: competitor.name,
        categorize: true,
        sentiment_analysis: true,
        output: flat_mapped(TIntelItem),
        requirements: [fill_summary_zh],
      );

      *rm(~/uuid-article.txt);

  - contextKeys: [intel]
    updateContextKeys: [intel]
    logic: |
      intel = *get_or_create_python_tool(
        quality_check & deduplicate_and_sort,
        intel,
        flatten_extends_nesting,
        output: flat(TIntelItem[]),
        dedupe_by: source_url,
        ensure_completeness,
        remove_empty_summaries,
        sort: date_desc,
      );

  - contextKeys: [intel]
    produceContextKeys: [title]
    logic: |
      const title = *summary(concise_title, lang: zh-TW);

  - contextKeys: [intel]
    produceContextKeys: [executive_summary_md]
    logic: |
      const executive_summary_md = *generate_brief(
        intel,
        format: markdown,
        role: executive_overview,
        tone: professional,
        lang: zh-TW,
      );

  - contextKeys: [intel]
    produceContextKeys: [takeaways]
    logic: |
      const takeaways = *generate_brief(
        intel,
        as: TBriefTakeaway[],
        include_key_takeaways: true,
        lang: zh-TW,
        max_items: 12,
      );

  - contextKeys: [intel]
    produceContextKeys: [sections]
    logic: |
      const sections = *generate_brief(
        intel,
        as: TBriefSection[],
        format: markdown,
        include_toc: true,
        lang: zh-TW,
      );

  - contextMode: true
    contextKeys: [title, executive_summary_md, takeaways, sections, intel]
    updateContextKeys: [result]
    logic: |
      (() => ({
        result: {
          executive_summary_md: context.context.executive_summary_md,
          generated_at: new Date().toISOString(),
          raw_intel: context.context.intel,
          sections: context.context.sections,
          takeaways: context.context.takeaways,
          title: context.context.title,
        }
      }));
