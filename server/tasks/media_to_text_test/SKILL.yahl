name: media-to-text-test
description: E2E test for media-to-text on a stable fixture image under ~/data/.
resultContextKey: result

stages:
  - contextKeys: []
    produceContextKeys: [image_path]
    logic: |
      Prefer existing task-persistent fixture ~/data/ocr-fixture.bmp.
      If missing, download with curl -fsSL into ~/data/ocr-fixture.bmp from:
      https://images.pexels.com/photos/301673/pexels-photo-301673.jpeg?auto=compress&cs=tinysrgb&w=800
      Persist image_path as '~/data/ocr-fixture.bmp' via set_context.
      Do not use ~/tmp for the fixture. Do not call nixery research.

  - contextKeys: [image_path]
    produceContextKeys: [extracted_text]
    logic: |
      Call /mastermind(media-to-text, file: image_path) once.
      Persist extracted_text only when the tool returns ok with non-empty plain text (trim length >= 5).
      Never set extracted_text to an empty string.
      Do not delete ~/data/ocr-fixture.bmp.

  - contextMode: true
    contextKeys: [extracted_text, image_path]
    produceContextKeys: [result]
    logic: |
      const extracted_text = context.context.extracted_text;
      const text = typeof extracted_text === 'string'
        ? extracted_text
        : JSON.stringify(extracted_text);
      if (!text || text.trim().length < 5) {
        throw new Error('extracted_text too short');
      }

      const result = {
        textLength: text.trim().length,
        message: 'media-to-text test passed',
        text: text.trim().slice(0, 200),
      };

      (() => ({result}))
