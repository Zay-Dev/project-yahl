name: media-to-text-test
description: E2E test for mastermind research, curl download, and media-to-text on a Pexels image.
resultContextKey: result

stages:
  - contextKeys: []
    produceContextKeys: [image_search]
    logic: |
      const image_search = /mastermind(research,
        topic: free stock photo direct download URL on pexels.com suitable for OCR text extraction test
      );

  - contextKeys: [image_search]
    produceContextKeys: [image_path]
    logic: |
      Use run_bash to download a direct image URL from image_search to ~/tmp/pexels-test.jpg with curl -fsSL.
      Persist image_path as '~/tmp/pexels-test.jpg' via set_context.

  - contextKeys: [image_path]
    produceContextKeys: [extracted_text]
    logic: |
      const extracted_text = /mastermind(media-to-text, file: image_path);
      *rm(~/tmp/pexels-test.jpg)

  - contextMode: true
    contextKeys: [extracted_text, image_path]
    produceContextKeys: [result]
    logic: |
      const extracted_text = context.context.extracted_text;
      const text = typeof extracted_text === 'string'
        ? extracted_text
        : JSON.stringify(extracted_text);
      if (!text || text.trim().length < 5) {
        throw new Error('extracted_text too short');
      }
      
      const result = {
        textLength: text.trim().length,
        message: 'media-to-text test passed',
        text: text.trim().slice(0, 200),
      };

      (() => ({result}))
