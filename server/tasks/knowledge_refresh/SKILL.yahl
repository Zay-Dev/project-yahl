name: knowledge-refresh
description: Unattended per-topic knowledge refresh — gap-fill and staleness update without clarify ask-user
background: true
resultContextKey: result
runInput:
  - knowledge_topic
  - rerun_intent

types: |
  type TLearningIntent = 'personal_interest' | 'preserve_for_future_tasks';

  type TLearningContract = {
    intent: TLearningIntent;
    topic: string;
    direction?: string;
    seedUrls: string[];
    depth: 'overview' | 'deep_dive';
    language?: string;
  };

  type TCorpusAssessment = {
    topic: string;
    existingKeys: string[];
    sufficientFor: string[];
    gaps: string[];
    lastUpdated?: string;
  };

  type TStudyPlanSource = {
    url: string;
    title?: string;
    priority: 'required' | 'optional';
    rounds: number;
    rationale: string;
  };

  type TStudyPlan = {
    researchQuestions: string[];
    successCriteria: string[];
    exclusions: string[];
    sources: TStudyPlanSource[];
    reuseExisting: string[];
    audience?: string;
  };

  type TKnowledgePersisted = {
    absolutePath: string;
    key: string;
    relativePath: string;
  };

  type TKnowledgePaths = {
    topic: string;
    topicWorkspace: string;
    studyWorkspace: string;
    missionPath: string;
    taskSkillsDir: string;
    persisted: TKnowledgePersisted[];
  };

  type TStudyDialogueState = {
    sources: unknown[];
    activeSourceSlug?: string;
    activeRound?: number;
  };

  type TSourceStudy = {
    url: string;
    title: string;
    studyMd: string;
    studiedAt: string;
    trustTier: 'high' | 'medium' | 'low';
  };

  type TSource = {
    title: string;
    url: string;
    fetchedAt: string;
    trustTier: 'high' | 'medium' | 'low';
    studyKey: string;
  };

  type TFacts = {
    items: {
      claim: string;
      sourceUrl: string;
      confidence: 'high' | 'medium' | 'low';
    }[];
  };

  type TAnalysis = {
    themes: string[];
    claims: string[];
    openQuestions: string[];
    confidence: string;
    intentAlignment: string;
  };

  type TResult = {
    knowledgeTopic: string;
    knowledgePaths: string[];
    refreshStatus: 'success' | 'skipped' | 'failed';
    summaryMd: string;
    personalizedBriefMd: string;
  };

  type TRerunIntent = {
    isRerun: true;
    proceedMode: 'update_selected' | 'full_refresh' | 'summary_only';
    updateScope: string[];
    addressOpenQuestions: boolean;
  };

stages:
  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load and summarize the topic corpus for refresh intake, rerun intent decisions, and learning contract assembly
      topic: knowledge_topic
      output: intake.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [knowledge_topic, rerun_intent]
    produceContextKeys: [knowledge_topic, missionText, refresh_policy, rerun_intent, learning_contract, refresh_skipped]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      IF: !knowledge_topic;
        const refresh_skipped = true;
      ELSE;
        const policyRef = /mastermind(resolve-topic-policy, topic: knowledge_topic);
        const refresh_policy = policyRef.row;
        const refresh_skipped = policyRef.refresh_skipped;
        const intakeFile = (*read('~/nixery/get-knowledge/intake.json'));
        const knowledgeExtractRef = { absent: intakeFile.absent ?? !intakeFile.extracted, path: '~/nixery/get-knowledge/intake.json' };
        IF: rerun_intent;
          // keep runInput-seeded rerun_intent
        ELSE IF: !knowledgeExtractRef.absent;
          const knowledge = (*read(knowledgeExtractRef.path)).extracted;
          const pending_open_questions = *extract_open_questions(knowledgeExtractRef, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const rerunBatch = *build_rerun_intent_batch(knowledge, pending_open_questions, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const rerunAnswers = /ask-user-batch(rerunBatch);
          const rerun_intent = *parse_rerun_intent(rerunAnswers);
        ELSE;
          const rerun_intent = *build_refresh_rerun_intent(refresh_policy, guideline: ~/task-skills/assess-refresh-gaps/SKILL.md);
        END:
        const learning_contract = knowledgeExtractRef.absent
          ? *default_learning_contract(knowledge_topic, guideline: ~/task-skills/assess-refresh-gaps/SKILL.md)
          : *load_learning_contract_from_corpus(knowledgeExtractRef, guideline: ~/task-skills/rerun-intent/SKILL.md);
      END:

  - contextMode: true
    contextKeys: [knowledge_topic, refresh_skipped]
    produceContextKeys: [knowledge_paths, study_dialogue, todo_pickup]
    logic: |
      (() => {
        if (context.context.refresh_skipped) {
          return {
            knowledge_paths: { topic: context.context.knowledge_topic, persisted: [] },
            study_dialogue: { sources: [] },
            todo_pickup: { items: [], summaryMd: '' },
          };
        }
        return {
          knowledge_paths: {
            topic: context.context.knowledge_topic,
            topicWorkspace: `~/knowledge/${context.context.knowledge_topic}`,
            studyWorkspace: `~/knowledge/${context.context.knowledge_topic}/study`,
            missionPath: '~/task-skills/task-mission/SKILL.md',
            taskSkillsDir: '~/task-skills',
            persisted: [],
          },
          study_dialogue: { sources: [] },
          todo_pickup: '<agent loads via pickup-todo skill>',
        };
      })

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load todo list and pending expand_questions items for pickup
      topic: knowledge_topic
      output: todo.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load open_questions_qa items for todo expand flow
      topic: knowledge_topic
      output: open-questions.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [knowledge_topic, knowledge_paths, refresh_skipped, missionText, todo_pickup, open_questions_qa]
    produceContextKeys: [todo_pickup, open_questions_qa]
    updateContextKeys: [knowledge_paths]
    logic: |
      IF: refresh_skipped;
        const todo_pickup = { items: [], summaryMd: '' };
      ELSE;
        Read ~/task-skills/pickup-todo/SKILL.md
        const todoFile = (*read('~/nixery/get-knowledge/todo.json'));
        const todoRef = { absent: todoFile.absent ?? !todoFile.extracted, path: '~/nixery/get-knowledge/todo.json' };
        const todo_pickup = todoRef.absent ? { items: [], summaryMd: '' } : (*read(todoRef.path)).extracted;
        const expandItems = *filter_todo_items(todo_pickup, kind: expand_questions, status: pending);
        IF: expandItems.length > 0;
          Read ~/task-skills/expand-open-questions/SKILL.md
          Read ~/task-skills/batch-open-questions/SKILL.md
          const oqFile = (*read('~/nixery/get-knowledge/open-questions.json'));
          const oqExtractRef = { absent: oqFile.absent ?? !oqFile.extracted, path: '~/nixery/get-knowledge/open-questions.json' };
          const open_questions_qa = oqExtractRef.absent ? [] : (*read(oqExtractRef.path)).extracted?.items ?? [];
          const batches = /mastermind(design-questions, stage: todo_expand, gaps: *todo_gaps_from_items(expandItems), priorQa: open_questions_qa, mission: missionText, goal: resolve todo expand_questions);
          const oqAnswers = /ask-user-batch(batches);
          const open_questions_qa = *merge_open_questions_qa(open_questions_qa, oqAnswers, guideline: ~/task-skills/answer-open-questions/SKILL.md);
          /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: open_questions_qa, value: { items: open_questions_qa });
          /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: todo, value: *mark_todo_items_done(todo_pickup, expandItems));
        END:
      END:

  - nixeryRun: list-knowledge-pages
    nixeryInput:
      topic: knowledge_topic
      output: pages.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - nixeryRun: search-knowledge
    nixeryInput:
      query: knowledge_topic
      topic: knowledge_topic
      output: gap-search.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [learning_contract, knowledge_topic, missionText, knowledge_paths, rerun_intent, refresh_skipped, TCorpusAssessment]
    produceContextKeys: [corpus_assessment]
    updateContextKeys: [knowledge_paths]
    logic: |
      IF: refresh_skipped;
        const corpus_assessment = { topic: knowledge_topic, existingKeys: [], sufficientFor: [], gaps: [] };
      ELSE;
        const pagesFile = (*read('~/nixery/list-knowledge-pages/pages.json'));
        const pagesRef = { absent: pagesFile.absent ?? !pagesFile.extracted, path: '~/nixery/list-knowledge-pages/pages.json' };
        const pages = pagesRef.absent ? [] : pagesFile.extracted;
        const searchFile = (*read('~/nixery/search-knowledge/gap-search.json'));
        const searchRef = { absent: searchFile.absent ?? !searchFile.extracted, path: '~/nixery/search-knowledge/gap-search.json' };
        const searchHits = searchRef.absent ? [] : searchFile.extracted;
        const knowledge = { pages, searchHits };
        const corpus_assessment = *assess_corpus(knowledge, learning_contract, guideline: ~/task-skills/locate-knowledge/SKILL.md);
        IF: *should_update_scope('studies', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md) || *should_update_scope('clarify', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const metaPersist = /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: corpus_assessment, value: corpus_assessment);
          EXTENDS: knowledge_paths = *append_persisted_path(knowledge_paths, metaPersist, key: corpus_assessment);
        END:
      END:

  - contextKeys: [learning_contract, knowledge_topic, corpus_assessment, missionText, knowledge_paths, rerun_intent, refresh_skipped, todo_pickup, TStudyPlan]
    produceContextKeys: [study_plan]
    updateContextKeys: [knowledge_paths]
    logic: |
      IF: refresh_skipped;
        const study_plan = { researchQuestions: [], successCriteria: [], exclusions: [], sources: [], reuseExisting: [] };
      ELSE;
        const plan = /mastermind(
          plan,
          goal: build refresh study plan,
          mission: missionText,
          facts: { learning_contract, corpus_assessment, mission: missionText, todo_pickup, today },
          guidelinePath: ~/task-skills/plan-study/SKILL.md,
        );
        const study_plan = *parse_study_plan(plan, depth: learning_contract.depth, corpus_assessment);
        IF: *should_update_scope('studies', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const planPersist = /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: study_plan, value: study_plan);
          EXTENDS: knowledge_paths = *append_persisted_path(knowledge_paths, planPersist, key: study_plan);
        END:
      END:

  - loopSetup: for each src of [study_plan.sources]
    contextKeys: [learning_contract, knowledge_topic, study_plan, corpus_assessment, missionText, knowledge_paths, study_dialogue, rerun_intent, refresh_skipped, TSource, TSourceStudy]
    updateContextKeys: [study_dialogue, sources, source_studies, knowledge_paths]
    logic: |
      IF: refresh_skipped;
        // no-op
      ELSE IF: *source_in_reuse_list(src, study_plan.reuseExisting, corpus_assessment) && !*should_update_scope('studies', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
        // skip fetch
      ELSE;
        const source_slug = *slugify_source(src.url);
        const studyKey = `study_${source_slug}`;
        const workspaceDir = `${knowledge_paths.studyWorkspace}/${source_slug}`;
        const rawMd = `${workspaceDir}/raw.md`;
        /stagehand(goto, url: src.url) → rawMd;
        for each round of [1..src.rounds];
          const priorPath = round === 1 ? rawMd : `${workspaceDir}/round-${round - 1}-agent.md`;
          const mastermindMd = `${workspaceDir}/round-${round}-mastermind.md`;
          const agentMd = `${workspaceDir}/round-${round}-agent.md`;
          /mastermind(
            research,
            source: priorPath,
            topic: study src for learning_contract,
            mission: missionText,
            facts: { learning_contract, study_plan, src, round, today, mission: missionText },
            guidelinePath: ~/task-skills/dialogue-round/SKILL.md,
          ) → mastermindMd;
          *agent_analyze_round(
            mastermindMd,
            output: agentMd,
            guideline: ~/task-skills/dialogue-round/SKILL.md,
            learning_contract,
            study_plan,
            src,
            round,
          );
          EXTENDS: study_dialogue = *append_dialogue_round(study_dialogue, src, round, mastermindMd, agentMd, rawMd);
        END:
        const finalMd = `${workspaceDir}/final.md`;
        *merge_dialogue_rounds(workspaceDir, src.rounds, output: finalMd);
        const studyMd = *read_capped(finalMd, maxBytes: 12000);
        const studyPersist = /mastermind(
          upsert-knowledge-page,
          topic: knowledge_topic,
          key: studyKey,
          value: { url: src.url, title: src.title || source_slug, studyMd, studiedAt: now_iso, trustTier: 'high' },
        );
        EXTENDS: knowledge_paths = *append_persisted_path(knowledge_paths, studyPersist, key: studyKey);
        EXTENDS: study_dialogue = *finalize_source_dialogue(study_dialogue, src, studyPersist);
        EXTENDS: sources = *append_source_index(sources, src, studyKey, now_iso);
        EXTENDS: source_studies = *append_source_study(source_studies, src, studyMd, now_iso);
      END:

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load facts, key_facts_md, and study_* content for facts stage assessment
      topic: knowledge_topic
      output: facts.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [learning_contract, knowledge_topic, study_plan, sources, source_studies, knowledge_paths, rerun_intent, refresh_skipped, TFacts]
    produceContextKeys: [facts, key_facts_md]
    updateContextKeys: [knowledge_paths, sources]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: knowledge-refresh-facts
    logic: |
      IF: refresh_skipped;
        const facts = { items: [] };
        const key_facts_md = '';
      ELSE;
        const missionText = missionText || *load_task_mission(~/task-skills/task-mission/SKILL.md);
        IF: !sources || !Array.isArray(sources) || sources.length === 0;
          const sources = *rebuild_sources_index(knowledge_topic);
          /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: sources, value: sources);
        END:
        const factsFile = (*read('~/nixery/get-knowledge/facts.json'));
        const knowledgeExtractRef = { absent: factsFile.absent ?? !factsFile.extracted, path: '~/nixery/get-knowledge/facts.json' };
        const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
        const assessment = *assess_learning_stage(stage: facts, knowledge, learning_contract, study_plan, sources, source_studies, rerun_intent);
        IF: assessment.sufficient && !*should_update_scope('facts', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const facts = assessment.artifact.facts;
          const key_facts_md = assessment.artifact.key_facts_md;
        ELSE;
          const extracted = /mastermind(
            research,
            topic: extract structured facts from persisted studies,
            mission: missionText,
            facts: { learning_contract, study_plan, sources, source_studies, mission: missionText },
            guidelinePath: ~/task-skills/study-source/SKILL.md,
          );
          const facts = *normalize_facts(extracted, as: TFacts);
          const key_facts_md = *facts_to_markdown(facts, study_plan);
        END:
        IF: !assessment.sufficient || *should_update_scope('facts', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const factsPersist = /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: facts, value: facts);
          EXTENDS: knowledge_paths = *append_persisted_path(knowledge_paths, factsPersist, key: facts);
        END:
      END:

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load user-onboarding profile slice — communication_style, preferences, goals, identity
      topic: user-onboarding
      output: profile.json
    logic: "(nixery)"

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load analysis and analysis_md for synthesis stage assessment
      topic: knowledge_topic
      output: synthesis.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [learning_contract, knowledge_topic, study_plan, sources, source_studies, facts, key_facts_md, rerun_intent, refresh_skipped, TAnalysis, userProfile]
    produceContextKeys: [analysis, analysis_md, userProfile]
    updateContextKeys: [knowledge_paths]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: knowledge-refresh-synthesis
    logic: |
      IF: refresh_skipped;
        const analysis = { themes: [], claims: [], openQuestions: [], confidence: '', intentAlignment: '' };
        const analysis_md = '';
      ELSE;
        const missionText = missionText || *load_task_mission(~/task-skills/task-mission/SKILL.md);
        const profileFile = (*read('~/nixery/get-knowledge/profile.json'));
        const userProfileExtractRef = { absent: profileFile.absent ?? !profileFile.extracted, path: '~/nixery/get-knowledge/profile.json' };
        const userProfile = userProfileExtractRef.absent ? '<none>' : (*read(userProfileExtractRef.path)).extracted;
        const synthesisFile = (*read('~/nixery/get-knowledge/synthesis.json'));
        const knowledgeExtractRef = { absent: synthesisFile.absent ?? !synthesisFile.extracted, path: '~/nixery/get-knowledge/synthesis.json' };
        const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
        const assessment = *assess_learning_stage(stage: synthesis, knowledge, learning_contract, study_plan, facts, sources, rerun_intent);
        IF: assessment.sufficient && !*should_update_scope('synthesis', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const synthesis_artifact = assessment.artifact;
        ELSE;
          const synthesis = /mastermind(
            research,
            topic: cross-source synthesis,
            mission: missionText,
            facts: { learning_contract, study_plan, facts, sources, source_studies, userProfile, mission: missionText },
            guidelinePath: ~/task-skills/synthesize-knowledge-summary/SKILL.md,
          );
          const synthesis_artifact = *parse_synthesis_artifact(synthesis, as: TAnalysis);
        END:
        const analysis = synthesis_artifact.analysis;
        const analysis_md = synthesis_artifact.analysis_md;
        IF: !assessment.sufficient || *should_update_scope('synthesis', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const analysisPersist = /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: analysis, value: analysis);
          EXTENDS: knowledge_paths = *append_persisted_path(knowledge_paths, analysisPersist, key: analysis);
          /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: analysis_md, value: { content: analysis_md });
        END:
      END:

  - nixeryRun: get-knowledge
    nixeryInput:
      purpose: Load summary corpus — summary, analysis, facts — for final brief stage
      topic: knowledge_topic
      output: summary.json
    contextKeys: [knowledge_topic]
    logic: "(nixery)"

  - contextKeys: [learning_contract, knowledge_topic, study_plan, sources, facts, analysis, analysis_md, userProfile, knowledge_paths, rerun_intent, refresh_skipped, TResult]
    produceContextKeys: [result, refresh_status]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: knowledge-refresh-summary
    logic: |
      IF: refresh_skipped;
        const refresh_status = 'skipped';
        const result = {
          knowledgeTopic: knowledge_topic,
          knowledgePaths: [],
          refreshStatus: 'skipped',
          summaryMd: '',
          personalizedBriefMd: '',
        };
      ELSE;
        const missionText = missionText || *load_task_mission(~/task-skills/task-mission/SKILL.md);
        const summaryFile = (*read('~/nixery/get-knowledge/summary.json'));
        const corpusExtractRef = { absent: summaryFile.absent ?? !summaryFile.extracted, path: '~/nixery/get-knowledge/summary.json' };
        IF: rerun_intent && rerun_intent.proceedMode === 'update_selected' && !*should_update_scope('summary', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const corpus = corpusExtractRef.absent ? '<none>' : (*read(corpusExtractRef.path)).extracted;
          const summaryMd = *load_summary_md_from_corpus(corpus);
          const personalizedBriefMd = *load_personalized_brief_from_corpus(corpus);
        ELSE;
          const corpus = corpusExtractRef.absent ? '<none>' : (*read(corpusExtractRef.path)).extracted;
          const profileFile = (*read('~/nixery/get-knowledge/profile.json'));
          const profileRef = { absent: profileFile.absent ?? !profileFile.extracted, path: '~/nixery/get-knowledge/profile.json' };
          const userProfile = userProfile || (profileRef.absent ? '<none>' : (*read(profileRef.path)).extracted);
          const brief = /mastermind(
            research,
            topic: final knowledge brief and personalized summary,
            mission: missionText,
            facts: { learning_contract, study_plan, sources, facts, analysis, analysis_md, userProfile, corpus, mission: missionText, today },
            guidelinePath: ~/task-skills/synthesize-knowledge-summary/SKILL.md,
          );
          const summaryMd = *parse_summary_md(brief);
          const personalizedBriefMd = *parse_personalized_brief_md(brief, userProfile, learning_contract);
        END:
        const knowledgePaths = knowledge_paths.persisted.map(p => p.relativePath);
        const refresh_status = 'success';
        const result = { knowledgeTopic: knowledge_topic, knowledgePaths, refreshStatus: 'success', summaryMd, personalizedBriefMd };
        /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: summary, value: { summaryMd, personalizedBriefMd, completed_at: now_iso });
        /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: meta, value: { slug: knowledge_topic, intent: learning_contract.intent, updated_at: now_iso });
      END:

  - contextKeys: [knowledge_topic, refresh_status, result, todo_pickup]
    produceContextKeys: [result]
    logic: |
      IF: !refresh_skipped && todo_pickup?.items?.length;
        Read ~/task-skills/pickup-todo/SKILL.md
        /mastermind(upsert-knowledge-page, topic: knowledge_topic, key: todo, value: *mark_remaining_todos_done(todo_pickup));
      END:
      /mastermind(
        patch-topic-policy,
        slug: knowledge_topic,
        lastRunAt: now_iso,
        lastRunStatus: refresh_status,
      );
      *echo('Call set_context with key result and the result object before ending this stage');

  - contextMode: true
    contextKeys: [result]
    updateContextKeys: [result]
    logic: |
      (() => ({ result: context.context.result }))
