name: knowledge-tidy
description: Detect and merge duplicate knowledges topic folders into canonical slugs
background: true
resultContextKey: result

types: |
  type TTidyDuplicateGroup = {
    canonical: string;
    members: string[];
    orphanFiles: string[];
    overlappingKeys: string[];
  };

  type TResult = {
    applied: boolean;
    dryRun: boolean;
    groupCount: number;
    groups: TTidyDuplicateGroup[];
    mergedKeys: string[];
    archived: string[];
  };

stages:
  - produceContextKeys: [tidy_report]
    logic: |
      const tidy_report = /mastermind(tidy-knowledge);
  - contextMode: true
    contextKeys: [tidy_report]
    produceContextKeys: [result]
    logic: |
      (() => {
        const report = context.context.tidy_report?.report ?? context.context.tidy_report;
        return {
          result: {
            applied: !!report?.applied,
            archived: report?.archived ?? [],
            dryRun: report?.dryRun !== false,
            groupCount: report?.groups?.length ?? 0,
            groups: report?.groups ?? [],
            mergedKeys: report?.mergedKeys ?? [],
          },
        };
      })
