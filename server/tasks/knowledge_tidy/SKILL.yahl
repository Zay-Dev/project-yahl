name: knowledge-tidy
description: Organize duplicate knowledges folders, migrate wiki layout, per-topic QA review, write todo pages for refresh
background: true
resultContextKey: result

types: |
  type TTidyDuplicateGroup = {
    canonical: string;
    members: string[];
    orphanFiles: string[];
    overlappingKeys: string[];
  };

  type TTopicWikiAudit = {
    canonical: string;
    deletedOrphans: string[];
    issues: string[];
    migratedKeys: string[];
    unmigratedOrphans: string[];
    wouldDelete: string[];
  };

  type TResult = {
    applied: boolean;
    dryRun: boolean;
    topicCount: number;
    migratedTopics: string[];
    qaReviewedTopics: string[];
    todoPagesWritten: string[];
    groups: TTidyDuplicateGroup[];
    mergedKeys: string[];
    archived: string[];
  };

stages:
  - produceContextKeys: [missionText, tidy_report]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      const tidy_report = /mastermind(tidy-knowledge);

  - contextMode: true
    contextKeys: [tidy_report]
    produceContextKeys: [tidy_topics]
    logic: |
      (() => {
        const report = context.context.tidy_report?.data?.report
          ?? context.context.tidy_report?.report
          ?? context.context.tidy_report;
        return {
          tidy_topics: Array.isArray(report?.topics) ? report.topics : [],
        };
      })

  - loopSetup: for each topic of [tidy_topics]
    contextKeys: [tidy_report, tidy_topics, missionText]
    produceContextKeys: [qa_review, todo_written]
    logic: |
      IF: tidy_report.dryRun;
        // skip QA loop on dry-run
      ELSE;
        Read ~/task-skills/qa-review-stage/SKILL.md
        const corpusRef = /mastermind(get-knowledge, topic: topic.canonical, need: overview, brief, facts, sources, raw keys);
        const qa_review = /mastermind(knowledge-qa-review, topic: topic.canonical, auditIssues: topic.issues);
        Read ~/task-skills/write-todo-page/SKILL.md
        /mastermind(upsert-knowledge-page, topic: topic.canonical, key: todo, value: *todo_value_from_qa_review(qa_review, topic: topic.canonical));
        const todo_written = topic.canonical;
      END:

  - contextMode: true
    contextKeys: [tidy_report, tidy_topics, qa_review, todo_written]
    produceContextKeys: [result]
    logic: |
      (() => {
        const report = context.context.tidy_report?.data?.report
          ?? context.context.tidy_report?.report
          ?? context.context.tidy_report;
        const topics = context.context.tidy_topics ?? report?.topics ?? [];
        const qaReviewed = Array.isArray(context.context.qa_review)
          ? context.context.qa_review.filter(Boolean)
          : (context.context.qa_review ? [context.context.qa_review] : []);
        const todoWritten = Array.isArray(context.context.todo_written)
          ? context.context.todo_written.filter(Boolean)
          : (context.context.todo_written ? [context.context.todo_written] : []);
        return {
          result: {
            applied: !!report?.applied,
            archived: report?.archived ?? [],
            dryRun: report?.dryRun !== false,
            groups: report?.groups ?? [],
            mergedKeys: report?.mergedKeys ?? [],
            migratedTopics: topics.map((entry) => entry.canonical).filter(Boolean),
            qaReviewedTopics: qaReviewed.map((entry) => entry?.review?.topic ?? entry?.topic).filter(Boolean),
            todoPagesWritten: todoWritten,
            topicCount: topics.length,
          },
        };
      })
