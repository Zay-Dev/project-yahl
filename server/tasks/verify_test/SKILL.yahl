name: verify-test
description: |
  E2E test for ask-user + mastermind verify.
  Manual flow: run task → answer ask-user → if verify fails with invalid answer, use Edit answer;
  if agent output failed, Resume (rerun); if question is bad, Resume (reask).
resultContextKey: result

stages:
  - contextMode: true
    produceContextKeys: [draft]
    logic: |
      const draft = {
        summary: 'Initial draft without user-approved metric.',
        metric: null,
      };

      (() => ({draft}))

  - askUser:
      - id: target_metric
        question: What numeric target metric (1-100) should this report use?
    contextKeys: [draft]
    produceContextKeys: [draft_with_metric]
    verify: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when draft_with_metric.metric is a number between 1 and 100.
      Fail when draft_with_metric is missing, zero, or NaN.
      On fail, set resumeAction:
      - edit_answer when the ask-user answer is not a valid number from 1 to 100 but the question is clear; set askUserRef to target_metric
      - rerun when the user answer looks like a valid number 1-100 but draft_with_metric was not written correctly
      - reask when the ask-user question or options are unusable; set askUserRef to target_metric
    logic: |
      const prior = *answer_of(target_metric);
      IF: prior;
        const metricAnswer = prior;
      ELSE;
        const metricAnswer = /ask-user(target_metric);
      END:
      const draft_with_metric = {
        ...draft,
        metric: Number(metricAnswer),
        userConfirmed: true,
      };

  - contextKeys: [draft_with_metric]
    produceContextKeys: [report]
    verify: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when report.metric is a number between 1 and 100 and report.summary mentions the metric value.
      Fail when metric is missing, zero, or summary does not reference the metric.
    logic: |
      const report = {
        metric: draft_with_metric.metric,
        summary: `Report uses approved metric ${draft_with_metric.metric}.`,
      };

  - contextMode: true
    contextKeys: [report]
    produceContextKeys: [result]
    logic: |
      const result = {
        message: 'verify-test passed',
        report: context.context.report,
      };

      (() => ({result}))
