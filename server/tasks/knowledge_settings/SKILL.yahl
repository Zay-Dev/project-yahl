name: knowledge-settings
description: Edit the global Knowledge Manager free-text instruction (do / don't / focus)
resultContextKey: result

types: |
  type TResult = {
    applied: boolean;
    text: string;
  };

stages:
  - produceContextKeys: [missionText, current_instruction, instruction_answers, next_instruction]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      const current = /mastermind(get-knowledge-manager-instruction);
      const current_instruction = current?.data?.text ?? '';
      const batch = *build_instruction_edit_batch(current_instruction, guideline: ~/task-skills/instruction-intake/SKILL.md);
      const instruction_answers = /ask-user-batch(batch);
      const next_instruction = *parse_instruction_text(instruction_answers, current_instruction, guideline: ~/task-skills/instruction-intake/SKILL.md);

  - contextKeys: [next_instruction]
    produceContextKeys: [result]
    logic: |
      const patched = /mastermind(put-knowledge-manager-instruction, text: next_instruction);
      const result = {
        applied: !!patched?.ok,
        text: next_instruction,
      };
      *echo('Call set_context with key result and the result object before ending this stage');

  - contextMode: true
    contextKeys: [result]
    updateContextKeys: [result]
    logic: |
      (() => ({ result: context.context.result }))
