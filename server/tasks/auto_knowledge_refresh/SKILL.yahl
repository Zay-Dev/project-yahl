name: auto-knowledge-refresh
description: Cron checkpoint — evaluate stale knowledge topics and dispatch knowledge_refresh runs
background: true
resultContextKey: result

types: |
  type TDispatchItem = {
    canonical: string;
    sessionId?: string;
    taskId: string;
  };

  type TResult = {
    checkedAt: string;
    dispatchCount: number;
    dispatched: TDispatchItem[];
    staleCount: number;
  };

stages:
  - produceContextKeys: [refresh_eval, stale_topics, missionText]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      const refresh_eval = /mastermind(evaluate-knowledge-refresh);
      *echo('set_context stale_topics from refresh_eval.data.staleTopics per ~/task-skills/dispatch-loop/SKILL.md');

  - loopSetup: for each topic of [stale_topics]
    contextKeys: [refresh_eval, stale_topics, missionText, dispatched]
    updateContextKeys: [dispatched]
    logic: |
      /mastermind(
        dispatch-task-run,
        taskId: knowledge_refresh,
        runInput: {
          knowledge_topic: topic.canonical,
          rerun_intent: {
            isRerun: true,
            proceedMode: update_selected,
            updateScope: topic.scopes,
            addressOpenQuestions: false,
          },
        },
      );
      *echo('set_context extend dispatched per ~/task-skills/dispatch-loop/SKILL.md');

  - contextMode: true
    contextKeys: [refresh_eval, dispatched]
    produceContextKeys: [result]
    logic: |
      (() => {
        const evalData = context.context.refresh_eval?.data ?? context.context.refresh_eval;
        const items = context.context.dispatched ?? [];
        return {
          result: {
            checkedAt: evalData?.checkedAt ?? '',
            dispatchCount: items.length,
            dispatched: items,
            staleCount: evalData?.staleTopics?.length ?? 0,
          },
        };
      })
