name: auto-knowledge-refresh
description: Cron checkpoint — dispatch Knowledge Manager full-corpus review (replaces stale-only evaluate)
background: true
resultContextKey: result

types: |
  type TResult = {
    checkedAt: string;
    sessionId?: string;
    taskId: string;
  };

stages:
  - produceContextKeys: [missionText, dispatch]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      const dispatch = /mastermind(
        dispatch-task-run,
        taskId: knowledge_manager,
        runInput: {},
      );

  - contextMode: true
    contextKeys: [dispatch]
    updateContextKeys: [result]
    logic: |
      (() => {
        const dispatch = context.context.dispatch ?? {};
        const data = dispatch.data ?? dispatch;
        return {
          result: {
            checkedAt: new Date().toISOString(),
            sessionId: data.sessionId,
            taskId: data.taskId ?? 'knowledge_manager',
          },
        };
      })
