name: whatsapp-channel-onboard
description: |
  Onboard a WhatsApp phone DM or group for message capture and seed wiki under
  whatsapp/{folder}/. Registers the channel so the worker starts persisting texts.
  Also records which phone the YAHL WhatsApp session uses (platform agent).
  Run with task id whatsapp_channel_onboard.
resultContextKey: result
runInput:
  - channelRef
  - displayName
  - agentPhone
  - assistantName

types: |
  type TPlatformIdentity = {
    chatId: string;
    displayName: string;
    lid?: string;
  };

  type TChannelRecord = {
    chatId: string;
    folder: string;
    displayName?: string;
    onboardedAt: string;
    wikiRoot: string;
  };

  type TResult = {
    channel: TChannelRecord;
    platform?: TPlatformIdentity;
    wikiPaths: string[];
  };

stages:
  - contextKeys: [channelRef, displayName, agentPhone, assistantName]
    produceContextKeys: [register_result, channel, platform]
    logic: |
      IF: !(channelRef && String(channelRef).trim());
        const ask = /ask-user-batch(clarify-whatsapp-channel);
        const channelRef = *pick_answer(ask, 'channelRef');
        const displayName = *pick_answer(ask, 'displayName');
        const agentPhone = *pick_answer(ask, 'agentPhone');
        const assistantName = *pick_answer(ask, 'assistantName');
      END:
      const register_result = /nixery(
        whatsapp-register-channel,
        channelRef: channelRef,
        displayName: displayName,
        agentPhone: agentPhone,
        assistantName: assistantName,
        output: register.json,
      );
      const channel = register_result.channel;
      const platform = register_result.platform;

  - contextKeys: [channel, channelRef, displayName, platform, assistantName]
    produceContextKeys: [overview_md, facts_md]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      Read ~/task-skills/onboard-channel/SKILL.md for writing style.
      Synthesize an observation-only background overview for this WhatsApp channel.
      Do not invent private facts; note unknowns as open questions.
      Prefer DM vs group framing from channel.chatId (@g.us => group).
      Treat platform (agent phone / assistantName) as the YAHL WhatsApp session — not a third-party bot.
      const overview_md = markdown overview for the channel (title, peer vs platform assistant, purpose, open questions).
      const facts_md = markdown bullet facts including channel identity and Platform agent section from platform.

  - contextKeys: [channel, platform, overview_md, facts_md]
    produceContextKeys: [overview_upsert, facts_upsert, result]
    logic: |
      const overview_upsert = /nixery(
        upsert-whatsapp-page,
        chatFolder: channel.folder,
        page: overview,
        content: overview_md,
        mode: replace,
        title: Overview,
        output: overview-upsert.json,
      );
      const facts_upsert = /nixery(
        upsert-whatsapp-page,
        chatFolder: channel.folder,
        page: facts,
        content: facts_md,
        mode: replace,
        title: Facts,
        output: facts-upsert.json,
      );
      const result = {
        channel,
        platform,
        wikiPaths: [overview_upsert.pagePath, facts_upsert.pagePath],
      };
