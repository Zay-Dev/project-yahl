goto:
  - command: '/stage(explorer)'
    description: 'when the cached/locked traffic source is no longer available or usable'
contextKeys: [started_at, fetches, prev_routes, summary_notified, notifications, miss_count, day_page, day_page_sections, last_heartbeat_at, prev_incident_note, poll_success_count, traffic_source, source_ops_md, notifyPreference, notifyName, notifyChannel, notifyTo, notifyIsUser, origin, destination, origin_resolved, destination_resolved, origin_display, destination_display, monitor_minutes, timezone, city_slug, source_instruction, instruction_active, verify_feedback, TTrafficFetch, TRouteSample, TMonitorResult, poll_miss, last_fetch, last_analysis, sleep_sec, bind_origin, bind_destination, label_origin, label_destination, bound_url, url_bound_od, page_ready, origin_ok, dest_ok, routes_ready]
updateContextKeys: [fetches, prev_routes, summary_notified, notifications, miss_count, last_heartbeat_at, prev_incident_note, source_ops_md, poll_success_count, day_page_sections, poll_miss, last_fetch, last_analysis, sleep_sec, bind_origin, bind_destination, bound_url, url_bound_od, page_ready, origin_ok, dest_ok, routes_ready]
agentOverrides:
  bashTimeoutMs: 360000
maxBashCalls: 120
maxTurns: 200
whileSetup:
  condition: "(Date.now() - Date.parse(String(context.context.started_at))) < Number(context.context.monitor_minutes) * 60 * 1000"
  doAtLeast: 2
warmUp: |
  Read ~/task-skills/monitor-loop/SKILL.md.
  Read ~/task-skills/route-analysis/SKILL.md.
  Read /opt/skills/worth-persisting-knowledge/SKILL.md.
  IF: instruction_active;
    *read(source_instruction);
  END:
  *read(source_ops_md);
  IF: verify_feedback;
    day_page_sections = [];
    *set_context(day_page_sections);
  END:
  const src_url = String(traffic_source.url || '');
  url_bound_od = src_url.includes('{origin}') && src_url.includes('{destination}');
  IF: url_bound_od;
    bound_url = *run_bash(node -e "const u=process.argv[1],o=process.argv[2],d=process.argv[3];process.stdout.write(u.replaceAll('{origin}',encodeURIComponent(o)).replaceAll('{destination}',encodeURIComponent(d)))" -- "${src_url}" "${bind_origin}" "${bind_destination}");
  ELSE:
    bound_url = src_url;
  END:
  *set_context(bound_url, url_bound_od);
  Prefer ~/data/scripts/ when present (yahl-browser goto). Else Stagehand goto bound_url.
  Open bound_url; confirm private-car / driving mode (not transit/walk/bike).
  page_ready = true;
  *set_context(page_ready);
  IF: url_bound_od;
    origin_ok = true;
    *set_context(origin_ok);
  ELSE:
    Prefer ~/data/scripts/fill-origin-input.js / pick-origin companions when present.
    Else Stagehand act/observe: type bind_origin; pick autocomplete matching district+landmark (reject hub drift).
    origin_ok = true when chip/field matches bind_origin;
    *set_context(origin_ok);
  END:
  IF: url_bound_od;
    dest_ok = true;
    *set_context(dest_ok);
  ELSE:
    Prefer ~/data/scripts/fill-destination companions when present.
    Else Stagehand act/observe: type bind_destination; pick matching suggestion.
    dest_ok = true when chip/field matches bind_destination;
    *set_context(dest_ok);
  END:
  Do not fetch, notify, append day-page, or sleep.
prefixOverride: |
  Warm-up already ran. Browser page is open; OD fields are set.
  Do not re-read ~/task-skills or /opt/skills; do not find / for schemas.
  Do not repeat goto, ensure, binds, or opening reads.
  Use Input context keys (bound_url, page_ready, origin_ok, dest_ok, and the rest).
  Execute this Input only.
logic:
  stages:
    - id: submit_wait
      maxTurns: 14
      maxBashCalls: 12
      contextKeys:
        [
          url_bound_od,
          origin_ok,
          dest_ok,
          page_ready,
          traffic_source,
          source_ops_md,
          routes_ready,
        ]
      updateContextKeys: [routes_ready]
      logic: |
        IF: url_bound_od;
          Wait until ≤3 private-car route cards are visible (observe/act; do not pass url on act/extract).
          routes_ready = true;
          *set_context(routes_ready);
        ELSE:
          Prefer scripted search/submit when present.
          Else Stagehand: submit directions search; wait for route cards (no page reload via url).
          routes_ready = true when cards visible;
          *set_context(routes_ready);
        END:

    - id: extract
      maxTurns: 20
      maxBashCalls: 16
      contextKeys:
        [
          routes_ready,
          bind_origin,
          bind_destination,
          label_origin,
          label_destination,
          bound_url,
          traffic_source,
          source_ops_md,
          prev_routes,
          miss_count,
          day_page,
          day_page_sections,
          started_at,
          monitor_minutes,
          timezone,
          TTrafficFetch,
        ]
      updateContextKeys:
        [
          last_fetch,
          poll_miss,
          miss_count,
          day_page_sections,
          source_ops_md,
          sleep_sec,
        ]
      logic: |
        Prefer ~/data/scripts/extract-routes-normalize.js when present; else Stagehand extract ≤3 routes + incident_note.
        const fetch = *normalize_traffic_fetch(
          extracted_routes,
          fetched_at: now_iso,
          source_url: bound_url,
          as: TTrafficFetch,
        );
        OD chips must match bind names — mismatch or empty routes → miss.
        IF: *fetch_failed(fetch);
          poll_miss = true;
          last_fetch = fetch;
          miss_count = miss_count + 1;
          *set_context(poll_miss, last_fetch, miss_count);
          const miss_section = *format_miss_section(prev_routes, origin: label_origin, destination: label_destination, timezone: timezone);
          *extend_context(day_page_sections, value: miss_section);
          /nixery(
            append-raw-knowledge-page,
            topic: traffic-monitor,
            page: day_page,
            mode: append,
            content: miss_section,
          );
          *submit_novel_ops(miss: true, fetch: fetch, source: traffic_source, source_ops_md);
          sleep_sec = *adaptive_sleep_sec(null, prev_primary_eta: *primary_eta(prev_routes) || 180, started_at, monitor_minutes);
          *set_context(sleep_sec);
        ELSE:
          poll_miss = false;
          last_fetch = fetch;
          *set_context(poll_miss, last_fetch);
        END:

    - id: analyze
      maxTurns: 30
      maxBashCalls: 20
      contextKeys:
        [
          poll_miss,
          last_fetch,
          label_origin,
          label_destination,
          prev_routes,
          prev_incident_note,
          poll_success_count,
          fetches,
          day_page,
          day_page_sections,
          timezone,
          TTrafficFetch,
          TRouteSample,
        ]
      updateContextKeys:
        [
          last_analysis,
          fetches,
          prev_routes,
          poll_success_count,
          day_page_sections,
          prev_incident_note,
          last_fetch,
        ]
      logic: |
        IF: !poll_miss;
          const analysis = *analyze_routes(last_fetch, prev_routes, prev_incident_note, ~/task-skills/route-analysis/SKILL.md);
          const fetch_with_status = { ...last_fetch, ...analysis.patch };
          last_analysis = analysis;
          last_fetch = fetch_with_status;
          *extend_context(fetches, value: fetch_with_status);
          prev_routes = fetch_with_status.routes;
          poll_success_count = poll_success_count + 1;
          *set_context(last_analysis, last_fetch, prev_routes, poll_success_count);
          const section_md = *format_fetch_section(fetch_with_status, analysis, origin: label_origin, destination: label_destination, timezone: timezone);
          *extend_context(day_page_sections, value: section_md);
          /nixery(
            append-raw-knowledge-page,
            topic: traffic-monitor,
            page: day_page,
            mode: append,
            content: section_md,
          );
          prev_incident_note = analysis.incident_note || '';
          *set_context(prev_incident_note);
        END:

    - id: notify_and_sleep
      maxTurns: 24
      maxBashCalls: 16
      contextKeys:
        [
          poll_miss,
          last_fetch,
          last_analysis,
          poll_success_count,
          summary_notified,
          notifications,
          notifyChannel,
          notifyTo,
          notifyPreference,
          notifyName,
          started_at,
          last_heartbeat_at,
          label_origin,
          label_destination,
          sleep_sec,
          monitor_minutes,
          traffic_source,
          source_ops_md,
        ]
      updateContextKeys:
        [summary_notified, notifications, last_heartbeat_at, sleep_sec, source_ops_md]
      logic: |
        IF: !poll_miss;
          IF: poll_success_count <== 2 && !summary_notified;
            *propose_kind_a_summary(last_fetch, last_analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications, origin: label_origin, destination: label_destination);
            summary_notified = poll_success_count >== 2;
            *set_context(summary_notified, notifications);
          END:
          IF: *heartbeat_due(notifyPreference, started_at, last_heartbeat_at);
            *propose_kind_b_heartbeat(last_fetch, last_analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications, origin: label_origin, destination: label_destination);
            last_heartbeat_at = new Date().toISOString();
            *set_context(last_heartbeat_at, notifications);
          END:
          IF: poll_success_count >= 2 && last_analysis.should_notify_abnormal;
            *propose_kind_c_abnormal(last_fetch, last_analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications, origin: label_origin, destination: label_destination);
            *set_context(notifications);
          END:
          *submit_novel_ops(miss: false, fetch: last_fetch, source: traffic_source, analysis: last_analysis, source_ops_md);
          sleep_sec = *adaptive_sleep_sec(last_fetch, prev_primary_eta: last_analysis.prev_primary_eta, started_at, monitor_minutes);
          *set_context(sleep_sec);
        END:
        *run_bash(sleep ${sleep_sec});
verify:
  defId: stage-verify
  autoRetry: true
  minScore: 0.75
  rubric: |
    Pass when started_at is set and unchanged,
    clock elapsed vs started_at is >= monitor_minutes OR elapsed already past window on retry,
    day_page non-empty, fetches is an array of real polls (no invented polls),
    miss_count is a number, notifications subset of real propose-notification outcomes.
    Count distinct polls by deduping fetches on fetched_at (±60s) plus primary-route eta_min;
    identical duplicate entries from retried context writes do not increase distinct poll count
    and must not fail the stage by themselves.
    Do not fail solely because raw fetches.length exceeds distinct poll count.
    For fetched_at vs Clock: do not treat timestamps as invented when they fall within
    [started_at, now_iso + 9h] (timezone mislabel tolerance) or when day_page_sections times corroborate;
    only fail future timestamps with no corroborating section or iteration evidence.
    When window allowed >=2 polls, require distinct_poll_count + miss_count >= 2 with miss sections covering gaps.
    Use read_context_key('day_page_sections'), fetches, origin_display, destination_display, origin, destination, miss_count.
    day_page_sections is a string array of append markdown for this run; do not read knowledge files or day_page path on disk.
    Dedupe sections by ## HH:MM header line; retried batches may duplicate entries — count distinct sections only.
    Each distinct section must contain Origin and Destination lines matching origin_display/destination_display (else runInput origin/destination).
    Distinct section count >= distinct_poll_count + miss_count - 1. Fail when any distinct section lacks Origin or Destination.
    On fail, set resumeAction: rerun.
