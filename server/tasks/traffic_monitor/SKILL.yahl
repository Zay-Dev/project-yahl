name: traffic-monitor
description: >
  Monitor driving traffic for a configurable origin → destination window (default 60 min);
  multi-route ETAs, notification proposals (initial / heartbeat / abnormal) tailored via resolve-notification-target,
  daily report vs city public holidays.
resultContextKey: result
background: true
runInput:
  - monitor_minutes
  - notify_to
  - origin
  - destination
  - source_instruction
  - city
  - timezone

types: |
  type TRouteSample = {
    label: string;
    via?: string;
    path?: string;
    eta_min: number;
    distance_km?: number;
    status: 'ok' | 'slow' | 'abnormal' | 'unknown';
  };

  type TTrafficFetch = {
    fetched_at: string;
    source_url: string;
    routes: TRouteSample[];
    recommended?: string;
    notes?: string;
    incident_note?: string;
  };

  type TTrafficSource = {
    url: string;
    howto_md: string;
    kind: 'browser' | 'api';
    city?: string;
    is_fallback: boolean;
  };

  type TTriedSource = {
    name: string;
    url: string;
    what_tried: string;
    outcome: 'ok' | 'failed' | 'skipped';
    why: string;
    at: string;
  };

  type TMonitorResult = {
    started_at: string;
    ended_at: string;
    elapsed_min: number;
    fetch_count: number;
    miss_count: number;
    day_page: string;
    fetches: TTrafficFetch[];
    notifications: unknown[];
  };

  type TResult = {
    started_at: string;
    day_kind: 'weekday' | 'weekend' | 'public_holiday';
    day_page: string;
    report_page?: string;
    monitor: TMonitorResult;
    summary_md: string;
  };

stages:
  - contextMode: true
    contextKeys: [monitor_minutes, notify_to, origin, destination, city, timezone]
    produceContextKeys: [monitor_minutes, notify_to, origin, destination, city, timezone, holidays_topic, holidays_file_prefix, traffic_source_file, city_slug, knowledge_topic]
    logic: |
      (() => {
        const cityRaw = String(context.context.city ?? '').trim() || 'Hong_Kong';
        const slug = cityRaw.toLowerCase().replace(/[_\s]+/g, '-');
        const slugUnderscored = slug.replace(/-/g, '_');
        const isHk = cityRaw === 'Hong_Kong' || slug === 'hong-kong';
        return {
          monitor_minutes: String(context.context.monitor_minutes ?? '').trim() || '60',
          notify_to: String(context.context.notify_to ?? '').trim() || '91234567',
          origin: String(context.context.origin ?? '').trim() || 'Kowloon Tong',
          destination: String(context.context.destination ?? '').trim() || 'Hong Kong International Airport',
          city: cityRaw,
          timezone: String(context.context.timezone ?? '').trim() || 'Asia/Hong_Kong',
          holidays_topic: isHk ? 'hk-public-holidays' : `${slug}-public-holidays`,
          holidays_file_prefix: isHk ? 'hk_public_holidays' : `${slugUnderscored}_public_holidays`,
          traffic_source_file: isHk ? 'traffic_source.md' : `${slugUnderscored}_traffic_source.md`,
          city_slug: slug,
          knowledge_topic: 'traffic-monitor',
        };
      })

  - contextKeys: [notify_to]
    nixeryRun: resolve-notification-target
    nixeryInput:
      to: notify_to
      output: notify-target.json
    logic: "(nixery)"

  - contextKeys: [notify_to]
    produceContextKeys: [notifyChannel, notifyTo, notifyName, notifyPreference, notifyIsUser]
    logic: |
      Read ~/nixery/resolve-notification-target/notify-target.json (or result.json) from the session workspace.
      Parse JSON once. When a string value is itself a JSON-encoded string (starts and ends with quotes), unwrap with JSON.parse once so values are bare scalars (whatsapp not "whatsapp").
      Set notifyChannel from channel (default whatsapp), notifyTo from to (fallback notify_to), notifyName from name (or ''), notifyPreference from preference (or ''), notifyIsUser from isUser (boolean; default false).
      Never JSON.stringify scalars before set_context.

  - contextKeys: [knowledge_topic, city_slug]
    nixeryRun: get-knowledge
    nixeryInput:
      purpose: |
        Seed from processed knowledge only — prefer verbatim cat of
        topics/{canonical}/source-ops-{city_slug}.md (full markdown body after frontmatter)
        and lean sources-{city_slug}.md bullets when present (also check registry aliases).
        Do NOT explore raw/ or raw/observations/. If those processed pages are missing, write absent:true.
        Do NOT synthesize Overview/History essays, multi-OD scrapbooks, or budget/exhausted/quota objects.
        Write the source-ops page body first in source-knowledge.md (verbatim sections HOWTO/PLACE/Q&A/ops-log).
        Prior BUDGET/HISTORY lines are avoid-list history, not a live research stop.
      topic: knowledge_topic
      output: source-knowledge.md
    logic: "(nixery)"

  - contextKeys: [city_slug]
    produceContextKeys: [source_ops_md]
    logic: |
      Read ~/nixery/get-knowledge/source-knowledge.md from the session workspace.
      If missing or empty after trim, set source_ops_md to '<none>'.
      Otherwise set source_ops_md to the source-ops-{city_slug} page body only
      (strip any Overview/History/sources preamble the extract may have added; keep HOWTO/PLACE/Q&A/ops-log).
      Do not keep a multi-OD essay scrapbook — prefer the verbatim wiki page body.

  - contextKeys: [origin, destination, city, holidays_topic, holidays_file_prefix, traffic_source_file]
    nixeryRun: plan
    nixeryInput:
      goal: Find or reuse a real-time driving traffic source for the run origin/destination and public holidays for the city/year
      stageLogic: |
        Prefer ~/data/{traffic_source_file} and ~/data/{holidays_file_prefix}_{year}.md when present for this city
        and the traffic source is usable with is_fallback not true.
        Do not reuse a traffic or holidays guideline from a different city.
        Otherwise research usable live multi-route private-car ETA sites and official public holiday lists for the city
        (any working city-local site; Google Maps is budget fallback only during explore, not preferred).
      output: plan.md
    logic: "(nixery)"

  - contextKeys: [holidays_topic]
    nixeryRun: get-knowledge
    nixeryInput:
      purpose: |
        Read processed holidays pages for the current calendar year when present; write holidays.md.
        Prefer topics/{canonical}/ calendar / facts / overview pages — do not explore raw/.
        If no dated holiday rows exist for the year, write absent:true.
      topic: holidays_topic
      output: holidays.md
    logic: "(nixery)"

  - contextKeys: [holidays_topic, holidays_file_prefix, city, timezone]
    produceContextKeys: [holidays_md, holidays_year]
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.75
      rubric: |
        Pass when holidays_year is a 4-digit year and holidays_md is a usable dated holiday list
        for that year (concrete dates / named public holidays). Fail when holidays_md is empty,
        contains absent: true, is only an absent diagnostic, or has no dated rows for the year.
        On fail, set resumeAction: rerun.
    logic: |
      Read ~/nixery/plan/plan.md when execution steps need clarification.
      # *holidays_list_usable: absent when missing/empty/'<none>'/absent:true/diagnostic-only/no dated rows for year.
      const holidays_year = *current_calendar_year_in_tz(timezone);
      Read ~/nixery/get-knowledge/holidays.md from the session workspace.
      If missing or empty after trim, set holidays_extract to '<none>'; otherwise set holidays_extract to the file's full markdown content.
      const extract_usable = *holidays_list_usable(holidays_extract, year: holidays_year);
      IF: extract_usable;
        const holidays_md = holidays_extract;
        *save(~/data/{holidays_file_prefix}_{holidays_year}.md, holidays_md);
      ELSE IF: *exists(~/data/{holidays_file_prefix}_{holidays_year}.md) && *holidays_list_usable(*read(~/data/{holidays_file_prefix}_{holidays_year}.md), year: holidays_year);
        const holidays_md = *read(~/data/{holidays_file_prefix}_{holidays_year}.md);
      ELSE:
        const holidays_md = /nixery(
          research,
          topic: city public holidays current year,
          need: official list of public holidays for holidays_year for city (prefer government open data for that city/region),
          format: markdown_dated_list,
          official_source_only: true,
        );
        *save(~/data/{holidays_file_prefix}_{holidays_year}.md, holidays_md);
        /nixery(
          append-raw-knowledge-page,
          topic: holidays_topic,
          page: raw/holidays-{holidays_year},
          mode: replace,
          content: holidays_md,
        );
      END:

  - conditionMode: true
    contextKeys: [source_instruction]
    produceContextKeys: [instruction_active]
    logic: |
      IF: !!(context.context.source_instruction && String(context.context.source_instruction).trim());
        (() => ({ instruction_active: true }));
      ELSE:
        (() => ({ instruction_active: false }));
      END:

  - id: explorer
    contextKeys: [origin, destination, city, city_slug, traffic_source_file, knowledge_topic, source_ops_md, source_instruction, instruction_active, TTrafficSource, TTrafficFetch, TRouteSample, TTriedSource]
    produceContextKeys: [traffic_source, probe_fetch, explore_started_at, source_ops_md, tried_sources, origin_resolved, destination_resolved]
    maxTurns: 80
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.75
      rubric: |
        Pass when origin_resolved and destination_resolved are non-empty (canonical; district when raw OD was brand/abbrev/mall/cinema),
        and they do NOT substitute a nearby MTR station for an estate/building runInput unless PLACE verified_proxy,
        and traffic_source.url is http(s) with {origin}/{destination} placeholders OR (kind browser and howto_md documents form-fill OD bind),
        and howto_md is inline markdown length >= 80 (not a ~/data path) and when kind browser has no concrete run OD/POI literals,
        and when is_fallback is false source_ops_md has reusable ## HOWTO for the locked provider,
        and is_fallback is boolean, explore_started_at is ISO, tried_sources is a non-null array,
        and city attempts (non-Maps, excluding known-broken cache declines) are <= 2,
        and every failed/skipped entry has why + what_tried and a matching SKIP/FAIL bullet in source_ops_md,
        and when is_fallback is false the locked city source is tried_sources outcome ok,
        and when is_fallback is true Maps was NOT saved/upserted as city lock,
        and when instruction_active is true the run applied source_instruction (no blind known-failed skip ignoring it;
        no trust-only lock with what_tried 'trusted durable cache; no re-probe' unless instruction clearly allows trust/skip-probe),
        and ONE of:
        (Trust path — cold start only, instruction_active false) probe_fetch.trusted_cache === true, source_url matches traffic_source.url,
        is_fallback false, tried_sources ok with what_tried 'trusted durable cache; no re-probe';
        OR (Live probe path) probe_fetch has >= 2 numeric eta_min routes and http(s) source_url
        OR documented OD geocode fail; browser form-fill chips match resolved places.
        Fail otherwise. On fail, set resumeAction: rerun.
    logic: |
      Read ~/task-skills/task-mission/SKILL.md.
      Read ~/task-skills/route-analysis/SKILL.md.
      *read(source_ops_md);
      *read(instruction_active);
      IF: instruction_active;
        *read(source_instruction);
      END:
      IF: stage_goto_reason;
        *read(stage_goto_reason);
        *read(stage_goto_from);
      END:

      const explore_started_at = new Date().toISOString();
      *set_context(explore_started_at);
      let source_ops_md = source_ops_md || '<none>';
      let locked = false;
      let tried_sources = [];
      let city_attempts = 0;
      const max_city_attempts = 2;
      const maps_template = 'https://www.google.com/maps/dir/{origin}/{destination}/';

      const origin_resolved = *resolve_place(origin, city: city, role: origin);
      const destination_resolved = *resolve_place(destination, city: city, role: destination);
      *set_context(origin_resolved, destination_resolved);
      *upsert_novel_place_ops(origin, origin_resolved, destination, destination_resolved);

      let candidate = null;
      IF: *exists(~/data/{traffic_source_file});
        candidate = *normalize_traffic_source(*read(~/data/{traffic_source_file}), as: TTrafficSource);
      ELSE:
        const from_knowledge = *extract_sources_page(~/nixery/get-knowledge/source-knowledge.md, key: sources-{city_slug});
        IF: from_knowledge;
          candidate = *normalize_traffic_source(from_knowledge, as: TTrafficSource);
        END:
      END:
      IF: candidate && (candidate.is_fallback === true || (String(candidate.url || '').includes('google.com/maps/dir/') && candidate.is_fallback !== false));
        candidate = null;
      END:

      IF: candidate && *already_tried_or_known_failed(candidate, tried_sources, source_ops_md) && !instruction_active;
        tried_sources = [...tried_sources, { name: *source_display_name(candidate), url: String(candidate.url || ''), what_tried: 'declined known-broken cached recommend; did not re-probe; does not burn city_attempts', outcome: 'skipped', why: *prior_skip_reason(candidate, tried_sources, source_ops_md) || 'prior skip/fail still applies in source_ops', at: new Date().toISOString() }];
        *upsert_skip_fail_ops(candidate, tried_sources[tried_sources.length - 1]);
        *set_context(source_ops_md, tried_sources);
        candidate = null;
      END:
      IF: candidate && *already_tried_or_known_failed(candidate, tried_sources, source_ops_md) && instruction_active;
        IF: *instruction_blocks_probe(source_instruction, candidate);
          tried_sources = [...tried_sources, { name: *source_display_name(candidate), url: String(candidate.url || ''), what_tried: 'declined per source_instruction; did not re-probe; does not burn city_attempts', outcome: 'skipped', why: *instruction_skip_reason(source_instruction, candidate) || 'source_instruction forbids this candidate', at: new Date().toISOString() }];
          *set_context(tried_sources);
          candidate = null;
        END:
      END:

      const candidate_usable = !!candidate && (String(candidate.url || '').includes('{origin}') || (String(candidate.kind || '') === 'browser' && String(candidate.howto_md || '').length >= 80));

      IF: candidate_usable && !stage_goto_reason && !instruction_active;
        let traffic_source = { ...candidate, city: city, is_fallback: false, howto_md: *strip_od_bleed(candidate.howto_md, origin, destination, origin_resolved, destination_resolved) };
        const probe_fetch = { trusted_cache: true, source_url: String(traffic_source.url || ''), routes: [] };
        tried_sources = [...tried_sources, { name: *source_display_name(traffic_source), url: traffic_source.url, what_tried: 'trusted durable cache; no re-probe', outcome: 'ok', why: 'cold-start non-fallback cache present and not known-failed', at: new Date().toISOString() }];
        *save(~/data/{traffic_source_file}, traffic_source);
        *ensure_howto_and_lock(traffic_source, source_ops_md);
        *set_context(traffic_source, probe_fetch, source_ops_md, tried_sources);
        locked = true;
      END:

      IF: !locked && candidate_usable;
        let traffic_source = { ...candidate, city: city, is_fallback: false, howto_md: *strip_od_bleed(candidate.howto_md, origin, destination, origin_resolved, destination_resolved) };
        const probe_fetch = *fetch_driving_routes(origin: origin_resolved, destination: destination_resolved, mode: private_car_driving, max_routes: 3, source: traffic_source, as: TTrafficFetch);
        IF: *probe_ok(probe_fetch) && !*od_geocode_failed(probe_fetch, origin_resolved, destination_resolved);
          tried_sources = [...tried_sources, { name: *source_display_name(traffic_source), url: traffic_source.url, what_tried: 'cached non-fallback probe', outcome: 'ok', why: 'probe returned usable multi-route ETAs', at: new Date().toISOString() }];
          *save(~/data/{traffic_source_file}, traffic_source);
          *ensure_howto_and_lock(traffic_source, source_ops_md);
          *upsert_novel_fetch_ops(miss: false, source: traffic_source, fetch: probe_fetch);
          *set_context(traffic_source, probe_fetch, source_ops_md, tried_sources);
          locked = true;
        ELSE:
          city_attempts = city_attempts + 1;
          const why = *od_geocode_failed(probe_fetch, origin_resolved, destination_resolved) ? (*geocode_fail_reason(probe_fetch, origin_resolved, destination_resolved) || 'OD geocode/district mismatch') : (*probe_fail_reason(probe_fetch) || 'cached probe failed');
          tried_sources = [...tried_sources, { name: *source_display_name(traffic_source), url: traffic_source.url, what_tried: 'cached non-fallback probe via howto_md + source_ops_md; at most 2 browser attempts', outcome: 'failed', why, at: new Date().toISOString() }];
          *upsert_skip_fail_ops(traffic_source, tried_sources[tried_sources.length - 1], probe_fetch);
          *set_context(source_ops_md, tried_sources);
        END:
      END:

      IF: !locked;
        while (!locked && city_attempts < max_city_attempts && (Date.now() - Date.parse(explore_started_at)) <= 30 * 60 * 1000) {
          IF: *about_to_hit_max_turns(remaining_le: 4) || (Date.now() - Date.parse(explore_started_at)) > 30 * 60 * 1000;
            break;
          END:
          const researched = *normalize_traffic_source(/nixery(research, topic: real-time driving traffic ETA origin to destination in city, need: *research_need_for_explore(city, tried_sources, source_ops_md, instruction_active, source_instruction), output_shape: TTrafficSource, howto_md_must_be_inline_markdown_not_a_path: true), as: TTrafficSource);
          IF: String(researched.url || '').includes('google.com/maps/dir/');
            break;
          END:
          IF: *already_tried_or_known_failed(researched, tried_sources, source_ops_md) && !instruction_active;
            city_attempts = city_attempts + 1;
            tried_sources = [...tried_sources, { name: *source_display_name(researched), url: String(researched.url || ''), what_tried: 'skipped re-probe; prior skip/fail still applies', outcome: 'skipped', why: *prior_skip_reason(researched, tried_sources, source_ops_md) || 'already failed/skipped in knowledge', at: new Date().toISOString() }];
            *upsert_skip_fail_ops(researched, tried_sources[tried_sources.length - 1]);
            *set_context(source_ops_md, tried_sources);
            continue;
          END:
          IF: *already_tried_or_known_failed(researched, tried_sources, source_ops_md) && instruction_active && *instruction_blocks_probe(source_instruction, researched);
            city_attempts = city_attempts + 1;
            tried_sources = [...tried_sources, { name: *source_display_name(researched), url: String(researched.url || ''), what_tried: 'skipped per source_instruction', outcome: 'skipped', why: *instruction_skip_reason(source_instruction, researched) || 'source_instruction forbids this candidate', at: new Date().toISOString() }];
            *set_context(tried_sources);
            continue;
          END:
          IF: !String(researched.url || '').includes('{origin}') && !*howto_documents_form_fill(researched.howto_md);
            city_attempts = city_attempts + 1;
            tried_sources = [...tried_sources, { name: *source_display_name(researched), url: String(researched.url || ''), what_tried: 'research returned candidate without placeholders and without form-fill howto', outcome: 'skipped', why: 'url missing placeholders and howto lacks form-fill binding steps', at: new Date().toISOString() }];
            *upsert_skip_fail_ops(researched, tried_sources[tried_sources.length - 1]);
            *set_context(source_ops_md, tried_sources);
            continue;
          END:
          IF: !String(researched.url || '').includes('{origin}') && *howto_documents_form_fill(researched.howto_md);
            researched = *prefer_placeholder_url(researched);
          END:
          const traffic_source = { ...researched, city: city, is_fallback: false, howto_md: *strip_od_bleed(researched.howto_md, origin, destination, origin_resolved, destination_resolved) };
          const probe_fetch = *fetch_driving_routes(origin: origin_resolved, destination: destination_resolved, mode: private_car_driving, max_routes: 3, source: traffic_source, as: TTrafficFetch);
          city_attempts = city_attempts + 1;
          IF: *probe_ok(probe_fetch) && !*od_geocode_failed(probe_fetch, origin_resolved, destination_resolved);
            tried_sources = [...tried_sources, { name: *source_display_name(traffic_source), url: traffic_source.url, what_tried: 'research + probe (howto_md + source_ops_md)', outcome: 'ok', why: 'probe returned usable multi-route ETAs', at: new Date().toISOString() }];
            *save(~/data/{traffic_source_file}, traffic_source);
            *ensure_howto_and_lock(traffic_source, source_ops_md);
            *upsert_novel_fetch_ops(miss: false, source: traffic_source, fetch: probe_fetch);
            *set_context(traffic_source, probe_fetch, source_ops_md, tried_sources);
            locked = true;
          ELSE:
            const why = *od_geocode_failed(probe_fetch, origin_resolved, destination_resolved) ? (*geocode_fail_reason(probe_fetch, origin_resolved, destination_resolved) || 'OD geocode/district mismatch') : (*probe_fail_reason(probe_fetch) || 'probe failed');
            tried_sources = [...tried_sources, { name: *source_display_name(traffic_source), url: traffic_source.url, what_tried: 'research + browser/API probe; at most 2 browser attempts', outcome: 'failed', why, at: new Date().toISOString() }];
            *upsert_skip_fail_ops(traffic_source, tried_sources[tried_sources.length - 1], probe_fetch);
            *set_context(source_ops_md, tried_sources);
          END:
        }
      END:

      IF: !locked;
        Read /opt/skills/google-maps-directions/SKILL.md.
        IF: city_attempts < max_city_attempts && (*about_to_hit_max_turns(remaining_le: 4) || (Date.now() - Date.parse(explore_started_at)) > 30 * 60 * 1000);
          *upsert_history_hard_stop(city_attempts, max_city_attempts);
        END:
        const traffic_source = { ...*normalize_traffic_source(/google-maps-directions(origin_resolved, destination_resolved), as: TTrafficSource), city: city, url: maps_template, kind: 'browser', howto_md: *maps_howto_md(), is_fallback: true };
        const probe_fetch = *fetch_driving_routes(origin: origin_resolved, destination: destination_resolved, mode: private_car_driving, max_routes: 3, source: traffic_source, as: TTrafficFetch);
        tried_sources = [...tried_sources, { name: 'Google Maps', url: maps_template, what_tried: 'google-maps-directions budget fallback probe', outcome: *probe_ok(probe_fetch) ? 'ok' : 'failed', why: *probe_ok(probe_fetch) ? 'fallback probe returned usable multi-route ETAs' : (*probe_fail_reason(probe_fetch) || 'fallback probe failed'), at: new Date().toISOString() }];
        *upsert_novel_fetch_ops(fallback: true, source: traffic_source, fetch: probe_fetch);
        IF: *exists(~/data/{traffic_source_file}) && *file_is_maps_fallback(~/data/{traffic_source_file});
          *delete(~/data/{traffic_source_file});
        END:
        *set_context(traffic_source, probe_fetch, source_ops_md, explore_started_at, tried_sources, origin_resolved, destination_resolved);
      END:

  - contextMode: true
    contextKeys: [timezone, started_at, fetches, prev_routes, summary_notified, notifications, miss_count, day_page, last_heartbeat_at, prev_incident_note]
    produceContextKeys: [started_at, fetches, prev_routes, summary_notified, notifications, miss_count, day_page, last_heartbeat_at, prev_incident_note]
    logic: |
      (() => {
        const existing = context.context.started_at;
        if (existing && String(existing).trim()) {
          return {
            started_at: context.context.started_at,
            fetches: Array.isArray(context.context.fetches) ? context.context.fetches : [],
            prev_routes: Array.isArray(context.context.prev_routes) ? context.context.prev_routes : [],
            summary_notified: context.context.summary_notified === true,
            notifications: Array.isArray(context.context.notifications) ? context.context.notifications : [],
            miss_count: Number(context.context.miss_count) || 0,
            day_page: String(context.context.day_page || ''),
            last_heartbeat_at: String(context.context.last_heartbeat_at || ''),
            prev_incident_note: String(context.context.prev_incident_note || ''),
          };
        }
        const started_at = new Date().toISOString();
        const tz = String(context.context.timezone ?? 'Asia/Hong_Kong');
        const offsetMs = tz === 'Asia/Hong_Kong' ? 8 * 60 * 60 * 1000 : 0;
        const y = new Date(Date.now() + offsetMs).toISOString().slice(0, 10);
        return {
          started_at,
          fetches: [],
          prev_routes: [],
          summary_notified: false,
          notifications: [],
          miss_count: 0,
          day_page: `raw/fetches-${y}`,
          last_heartbeat_at: '',
          prev_incident_note: '',
        };
      });

  - id: monitor
    goto:
      - command: '/stage(explorer)'
        description: 'when the cached/locked traffic source is no longer available or usable'
    contextKeys: [started_at, fetches, prev_routes, summary_notified, notifications, miss_count, day_page, last_heartbeat_at, prev_incident_note, traffic_source, source_ops_md, notifyPreference, notifyName, notifyChannel, notifyTo, notifyIsUser, holidays_md, origin, destination, origin_resolved, destination_resolved, monitor_minutes, timezone, knowledge_topic, city_slug, source_instruction, instruction_active, TTrafficFetch, TRouteSample, TMonitorResult]
    produceContextKeys: [fetches, prev_routes, summary_notified, notifications, miss_count, monitor, last_heartbeat_at, prev_incident_note, source_ops_md]
    agentOverrides:
      bashTimeoutMs: 360000
    maxBashCalls: 120
    maxTurns: 200
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.75
      rubric: |
        Pass when started_at unchanged, monitor.ended_at set,
        monitor.elapsed_min >= monitor_minutes OR elapsed already past window on retry,
        monitor.day_page non-empty, monitor.fetches length equals fetch_count and context fetches
        (no invented polls), notifications subset of real propose-notification outcomes.
        When window allowed >=2 polls, require fetch_count + miss_count >= 2 with miss sections covering gaps.
        This-run day-page sections (matching Origin/Destination) present with Origin and Destination lines;
        count >= fetch_count + miss_count - 1. Fail when any this-run section lacks Origin or Destination.
        On fail, set resumeAction: rerun.
    logic: |
      Read ~/task-skills/monitor-loop/SKILL.md.
      Read ~/task-skills/route-analysis/SKILL.md.
      IF: instruction_active;
        *read(source_instruction);
      END:
      *read(source_ops_md);
      *read(holidays_md);
      const window_ms = Number(monitor_minutes) * 60 * 1000;
      const notifications = notifications || [];
      const fetches = fetches || [];
      let prev_routes = prev_routes;
      let summary_notified = summary_notified === true;
      let miss_count = miss_count || 0;
      let last_heartbeat_at = last_heartbeat_at || '';
      let prev_incident_note = prev_incident_note || '';
      let source_ops_md = source_ops_md || '<none>';
      const bind_origin = origin_resolved || origin;
      const bind_destination = destination_resolved || destination;

      IF: (Date.now() - Date.parse(started_at)) >= window_ms;
        const monitor = {
          started_at,
          ended_at: new Date().toISOString(),
          elapsed_min: Math.floor((Date.now() - Date.parse(started_at)) / 60000),
          fetch_count: fetches.length,
          miss_count,
          day_page,
          fetches,
          notifications,
        };
      ELSE:
        while ((Date.now() - Date.parse(started_at)) < window_ms) {
          *read(source_ops_md);
          const fetch = *fetch_driving_routes(
            origin: bind_origin,
            destination: bind_destination,
            mode: private_car_driving,
            max_routes: 3,
            source: traffic_source,
            as: TTrafficFetch,
          );
          IF: *fetch_failed(fetch);
            miss_count = miss_count + 1;
            *set_context(miss_count);
            /nixery(
              append-raw-knowledge-page,
              topic: knowledge_topic,
              page: day_page,
              mode: append,
              content: *format_miss_section(prev_routes, origin: bind_origin, destination: bind_destination, timezone: timezone),
            );
            *submit_novel_ops(miss: true, fetch: fetch, source: traffic_source, source_ops_md);
            const sleep_sec = *adaptive_sleep_sec(null, prev_primary_eta: *primary_eta(prev_routes) || 180);
          ELSE:
            const analysis = *analyze_routes(fetch, prev_routes, prev_incident_note, holidays_md, ~/task-skills/route-analysis/SKILL.md);
            const fetch_with_status = { ...fetch, ...analysis.patch };
            *set_context(fetches, operation: extend, value: fetch_with_status);
            prev_routes = fetch_with_status.routes;
            *set_context(prev_routes);
            fetches = [...fetches, fetch_with_status];
            /nixery(
              append-raw-knowledge-page,
              topic: knowledge_topic,
              page: day_page,
              mode: append,
              content: *format_fetch_section(fetch_with_status, analysis, origin: bind_origin, destination: bind_destination, timezone: timezone),
            );
            IF: fetches.length <== 2 && !summary_notified;
              *propose_kind_a_summary(fetches, analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications);
              summary_notified = fetches.length >== 2;
              *set_context(summary_notified, notifications);
            END:
            IF: *heartbeat_due(notifyPreference, started_at, last_heartbeat_at);
              *propose_kind_b_heartbeat(fetch_with_status, analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications);
              last_heartbeat_at = new Date().toISOString();
              *set_context(last_heartbeat_at, notifications);
            END:
            IF: fetches.length >= 2 && analysis.should_notify_abnormal;
              *propose_kind_c_abnormal(fetch_with_status, analysis, notifyChannel, notifyTo, notifyPreference, notifyName, notifications);
              *set_context(notifications);
            END:
            prev_incident_note = analysis.incident_note || '';
            *set_context(prev_incident_note);
            *submit_novel_ops(miss: false, fetch: fetch_with_status, source: traffic_source, analysis: analysis, source_ops_md);
            const sleep_sec = fetches.length === 1
              ? 300
              : *adaptive_sleep_sec(fetch_with_status, prev_primary_eta: analysis.prev_primary_eta);
          END:
          IF: (Date.now() - Date.parse(started_at)) >= window_ms;
            break;
          END:
          *run_bash(sleep ${sleep_sec});
        }
        const monitor = {
          started_at,
          ended_at: new Date().toISOString(),
          elapsed_min: Math.floor((Date.now() - Date.parse(started_at)) / 60000),
          fetch_count: fetches.length,
          miss_count,
          day_page,
          fetches,
          notifications,
        };
      END:

  - contextKeys: [started_at, monitor, holidays_md, day_page, origin, destination, city, timezone, knowledge_topic, traffic_source, TResult, TMonitorResult]
    produceContextKeys: [result]
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.75
      rubric: |
        Pass when result.day_kind is weekday|weekend|public_holiday, result.summary_md is non-empty,
        and result.monitor.fetch_count matches monitor.fetch_count, and result.monitor.miss_count
        matches monitor.miss_count,
        and summary_md / notification bodies use runInput origin and destination labels (not bound MTR/station proxies),
        and summary_md names the locked traffic_source (Google Maps only when traffic_source.is_fallback is true
        or url is the Maps directions template; otherwise name the city source from traffic_source.url / howto),
        and every report raw upsert returned ok:true with canonicalTopic equal to knowledge_topic
        (path under topics/traffic-monitor/ — never topics/general/).
        Fail when day_kind or summary_md is missing.
        Fail when any report raw upsert omitted topic, returned ok:false, or landed outside traffic-monitor.
        Do not require a SUMMARY submit-knowledge-observation.
        Day page may contain earlier same-day runs — do NOT fail solely because total `## HH:MM`
        count exceeds this run's fetch_count + miss_count. Require this-run sections (Origin/Destination
        matching context) to be present with Origin and Destination lines; count >= fetch+miss - 1.
        Fail when summary_md claims Google Maps but traffic_source.is_fallback is false and url is not Maps.
        On fail, set resumeAction: rerun.
    logic: |
      Read ~/task-skills/task-mission/SKILL.md.
      Read ~/task-skills/route-analysis/SKILL.md.
      *read(holidays_md);
      const day_kind = *classify_day_kind(started_at, holidays_md, tz: timezone);
      const summary_md = *write_daily_traffic_report(
        monitor,
        day_kind,
        holidays_md,
        route: origin to destination driving,
        city: city,
        tz: timezone,
        traffic_source: traffic_source,
      );
      const report_page = `raw/report-${day_page.replace('raw/fetches-', '')}`;
      const report_append_md = *format_report_run_append(
        summary_md,
        origin: origin,
        destination: destination,
        monitor: monitor,
        timezone: timezone,
      );
      const report_up = /nixery(
        append-raw-knowledge-page,
        topic: knowledge_topic,
        page: report_page,
        mode: append,
        content: report_append_md,
      );
      IF: !*last_nixery_ok();
        /nixery(
          append-raw-knowledge-page,
          topic: knowledge_topic,
          page: report_page,
          mode: append,
          content: report_append_md,
        );
      END:
      *assert_upsert_topic(report_up, topic: knowledge_topic);
      const result = {
        started_at,
        day_kind,
        day_page,
        report_page,
        monitor,
        summary_md,
      };

  - contextMode: true
    contextKeys: [result]
    updateContextKeys: [result]
    logic: |
      (() => ({ result: context.context.result }))