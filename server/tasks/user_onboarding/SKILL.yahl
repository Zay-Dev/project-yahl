name: user-onboarding
description: |
  Build and maintain a personal assistant user profile across five deepening stages.
  Produces dual Markdown profiles (mastermind + agent) as session result.
resultContextKey: result

types: |
  type TIdentityProfile = {
    preferredName: string;
    role: string;
    timezone: string;
    languages: string[];
    background: string;
  };

  type TGoalsProfile = {
    shortTermGoals: string[];
    longTermGoals: string[];
    priorities: string[];
    successCriteria: string[];
  };

  type TPreferencesProfile = {
    tools: string[];
    topics: string[];
    boundaries: string[];
    avoid: string[];
  };

  type TCommunicationProfile = {
    tone: string;
    detailLevel: string;
    languagePreference: string;
    proactivity: string;
  };

  type TResult = {
    mastermind: string;
    agent: string;
  };

  type TRerunIntent = {
    isRerun: true;
    proceedMode: 'update_selected' | 'full_refresh' | 'summary_only';
    updateScope: string[];
    addressOpenQuestions: boolean;
  };

  type TOpenQuestionQaItem = {
    questionRef: string;
    question: string;
    answer: string;
  };

  type TOpenQuestions = {
    items: string[];
  };

stages:
  - produceContextKeys: [identity_profile, stage1_qa_log, rerun_intent, pending_open_questions, open_questions_qa]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when identity_profile has non-empty preferredName, role, timezone, languages (array length >= 1), and background.
      Fail when any required identity field is missing, placeholder, or contradicts persisted user-onboarding knowledge.
      On fail with incomplete profile, set resumeAction follow_up with askUserRef for the most critical missing field.
      On fail when ask-user answer is invalid, set edit_answer with askUserRef.
      On fail when stage output wrong but answers valid, set rerun.
    logic: |
      const knowledgeExtractRef = /mastermind(extract-knowledge, topic: user-onboarding, need: identity, background_summary, goals, preferences, communication_style, open_questions, onboarding_completed_at, user_profile_summary);
      const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
      IF: !knowledgeExtractRef.absent;
        const pending_open_questions = *extract_open_questions(knowledgeExtractRef, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const rerunBatch = *build_rerun_intent_batch(knowledge, pending_open_questions, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const rerunAnswers = /ask-user-batch(rerunBatch);
        const rerun_intent = *parse_rerun_intent(rerunAnswers);
        IF: rerun_intent.addressOpenQuestions && pending_open_questions.length > 0;
          const pickBatch = *build_open_questions_pick_batch(pending_open_questions, guideline: ~/task-skills/rerun-intent/SKILL.md);
          const pickAnswers = /ask-user-batch(pickBatch);
          const batches = /mastermind(design-questions, stage: open_questions, mission: Build a personal assistant user profile for future teamwork — questions are about the USER not about onboarding mechanics, gaps: *picked_open_questions(pickAnswers), priorQa: open_questions_qa, goal: resolve pending profile gaps);
          const oqAnswers = /ask-user-batch(batches);
          const open_questions_qa = *merge_open_questions_qa(open_questions_qa, oqAnswers, guideline: ~/task-skills/rerun-intent/SKILL.md);
          /mastermind(persist-knowledge, topic: user-onboarding, key: open_questions_qa, value: { items: open_questions_qa });
        END:
      END:
      // Read ~/task-skills/assess-onboarding-stage/SKILL.md — assess stage 1 gaps vs knowledge + onboarding_qa_1 + rerun_intent
      const assessment = *assess_onboarding_stage(stage: 1, knowledge, priorQa: onboarding_qa_1, rerun_intent);
      IF: assessment.sufficient && !*should_update_scope('identity', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const identity_profile = assessment.profile;
        const stage1_qa_log = onboarding_qa_1 || [];
      ELSE;
        const batches = /mastermind(design-questions, stage: 1, mission: Build a personal assistant user profile for future teamwork — questions are about the USER not about onboarding mechanics, gaps: assessment.gaps, priorQa: onboarding_qa_1, goal: identity and background);
        const batchAnswers = /ask-user-batch(batches);
        const stage1_qa_log = *merge_qa(onboarding_qa_1, batchAnswers);
        const identity_profile = *build_identity_profile(stage1_qa_log, knowledge);
      END:
      /mastermind(persist-knowledge, topic: user-onboarding, key: identity, value: identity_profile);
      /mastermind(persist-knowledge, topic: user-onboarding, key: background_summary, value: identity_profile.background);

  - contextKeys: [identity_profile, stage1_qa_log, rerun_intent]
    produceContextKeys: [goals_profile, stage2_qa_log]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when goals_profile has non-empty shortTermGoals, longTermGoals, priorities, and successCriteria arrays.
      Fail when goals are missing or contradict identity_profile or persisted knowledge.
      Use follow_up for incomplete goal data; edit_answer when a specific ask-user answer is wrong; rerun when output mapping failed.
    logic: |
      const knowledgeExtractRef = /mastermind(extract-knowledge, topic: user-onboarding, need: goals, priorities);
      const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
      const assessment = *assess_onboarding_stage(stage: 2, knowledge, priorQa: onboarding_qa_2, identity_profile, rerun_intent);
      IF: assessment.sufficient && !*should_update_scope('goals', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const goals_profile = assessment.profile;
        const stage2_qa_log = onboarding_qa_2 || [];
      ELSE;
        const batches = /mastermind(design-questions, stage: 2, mission: Build a personal assistant user profile for future teamwork — questions are about the USER not about onboarding mechanics, gaps: assessment.gaps, priorQa: onboarding_qa_2, goal: goals and priorities);
        const batchAnswers = /ask-user-batch(batches);
        const stage2_qa_log = *merge_qa(onboarding_qa_2, batchAnswers);
        const goals_profile = *build_goals_profile(stage2_qa_log, knowledge, identity_profile);
      END:
      // Read ~/task-skills/build-onboarding-profiles/SKILL.md — goals_profile must be in context before verify
      /mastermind(persist-knowledge, topic: user-onboarding, key: goals, value: goals_profile);
      /mastermind(persist-knowledge, topic: user-onboarding, key: priorities, value: goals_profile.priorities);

  - contextKeys: [identity_profile, goals_profile, stage1_qa_log, stage2_qa_log, rerun_intent]
    produceContextKeys: [preferences_profile, stage3_qa_log]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when preferences_profile has tools, topics, boundaries, and avoid arrays with substantive entries.
      Fail when preferences are missing or contradict prior stage profiles.
      Use follow_up, edit_answer, or rerun as appropriate.
    logic: |
      const knowledgeExtractRef = /mastermind(extract-knowledge, topic: user-onboarding, need: preferences, constraints);
      const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
      const assessment = *assess_onboarding_stage(stage: 3, knowledge, priorQa: onboarding_qa_3, rerun_intent);
      IF: assessment.sufficient && !*should_update_scope('preferences', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const preferences_profile = assessment.profile;
        const stage3_qa_log = onboarding_qa_3 || [];
      ELSE;
        const batches = /mastermind(design-questions, stage: 3, mission: Build a personal assistant user profile for future teamwork — questions are about the USER not about onboarding mechanics, gaps: assessment.gaps, priorQa: onboarding_qa_3, goal: preferences and constraints);
        const batchAnswers = /ask-user-batch(batches);
        const stage3_qa_log = *merge_qa(onboarding_qa_3, batchAnswers);
        const preferences_profile = *build_preferences_profile(stage3_qa_log, knowledge);
      END:
      // Read ~/task-skills/build-onboarding-profiles/SKILL.md — preferences_profile.topics must be string[]
      /mastermind(persist-knowledge, topic: user-onboarding, key: preferences, value: preferences_profile);
      /mastermind(persist-knowledge, topic: user-onboarding, key: constraints, value: preferences_profile.boundaries);

  - contextKeys: [identity_profile, goals_profile, preferences_profile, rerun_intent]
    produceContextKeys: [communication_profile, stage4_qa_log]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when communication_profile has non-empty tone, detailLevel, languagePreference, and proactivity.
      Fail when communication style is missing or contradicts prior profiles.
      Use follow_up, edit_answer, or rerun as appropriate.
    logic: |
      const knowledgeExtractRef = /mastermind(extract-knowledge, topic: user-onboarding, need: communication_style);
      const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
      const assessment = *assess_onboarding_stage(stage: 4, knowledge, priorQa: onboarding_qa_4, rerun_intent);
      IF: assessment.sufficient && !*should_update_scope('communication', rerun_intent, guideline: ~/task-skills/rerun-intent/SKILL.md);
        const communication_profile = assessment.profile;
        const stage4_qa_log = onboarding_qa_4 || [];
      ELSE;
        const batches = /mastermind(design-questions, stage: 4, mission: Build a personal assistant user profile for future teamwork — questions are about the USER not about onboarding mechanics, gaps: assessment.gaps, priorQa: onboarding_qa_4, goal: communication style);
        const batchAnswers = /ask-user-batch(batches);
        const stage4_qa_log = *merge_qa(onboarding_qa_4, batchAnswers);
        const communication_profile = *build_communication_profile(stage4_qa_log, knowledge);
      END:
      /mastermind(persist-knowledge, topic: user-onboarding, key: communication_style, value: communication_profile);

  - contextKeys: [identity_profile, goals_profile, preferences_profile, communication_profile, stage1_qa_log, stage2_qa_log, stage3_qa_log, stage4_qa_log, rerun_intent, open_questions_qa, pending_open_questions, TResult]
    produceContextKeys: [result, open_questions]
    verify: true
    verifyAutoRetry: true
    verifyMinScore: 0.75
    verifyRubric: |
      Pass when result.mastermind and result.agent are non-empty Markdown with sections for identity, goals, preferences, and communication.
      Fail when either field is missing, placeholder, or contradicts persisted knowledges/user-onboarding facts.
      Use follow_up for gap-fill batches before synthesis; rerun when synthesis mapping failed.
    logic: |
      const knowledgeExtractRef = /mastermind(extract-knowledge, topic: user-onboarding, need: all stage keys, open_questions, qa logs);
      const knowledge = knowledgeExtractRef.absent ? '<none>' : (*read(knowledgeExtractRef.path)).extracted;
      IF: rerun_intent && rerun_intent.proceedMode === 'summary_only';
        const identity_profile = *load_profile_from_knowledge(knowledge, key: identity, as: TIdentityProfile);
        const goals_profile = *load_profile_from_knowledge(knowledge, key: goals, as: TGoalsProfile);
        const preferences_profile = *load_profile_from_knowledge(knowledge, key: preferences, as: TPreferencesProfile);
        const communication_profile = *load_profile_from_knowledge(knowledge, key: communication_style, as: TCommunicationProfile);
      END:
      // Read ~/task-skills/synthesize-user-profile/SKILL.md — use ask_user fallbacks when profile keys missing
      const facts = {
        identity_profile,
        goals_profile,
        preferences_profile,
        communication_profile,
        stage1_qa_log,
        stage2_qa_log,
        stage3_qa_log,
        stage4_qa_log,
        knowledge,
        rerun_intent,
        open_questions_qa,
        pending_open_questions,
      };
      const mastermindMd = /mastermind(
        research,
        topic: synthesize user profile markdown,
        guidelinePath: ~/task-skills/synthesize-user-profile/SKILL.md,
        facts,
      );
      const agentMd = *synthesize_user_profile_agent(facts, guideline: ~/task-skills/synthesize-user-profile/SKILL.md);
      const result = { mastermind: mastermindMd, agent: agentMd };
      const open_questions = *extract_open_questions_from_synthesis(mastermindMd, agentMd, open_questions_qa, pending_open_questions, guideline: ~/task-skills/synthesize-user-profile/SKILL.md);
      /mastermind(persist-knowledge, topic: user-onboarding, key: user_profile_summary, value: result);
      /mastermind(persist-knowledge, topic: user-onboarding, key: open_questions, value: open_questions);
      /mastermind(persist-knowledge, topic: user-onboarding, key: onboarding_completed_at, value: *now_iso());

  - contextMode: true
    contextKeys: [result]
    updateContextKeys: [result]
    logic: |
      (() => ({ result: context.context.result }))
