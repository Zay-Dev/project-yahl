name: knowledge-manager
description: Multi-stage overnight Knowledge Manager — per-topic validate/apply + cross-topic transfer proposals
background: true
resultContextKey: result

types: |
  type TReviewRecord = {
    topic: string;
    depth: 'focus' | 'light';
    honeApplied: number;
    honeSkipped: number;
    opsApplied: number;
    opsDiscarded: number;
    quizTodoAdded: boolean;
    transfersProposed: number;
    consumed?: number;
    skippedEmpty?: boolean;
    applyFailed?: boolean;
  };

  type TTopicGroup = {
    id: string;
    topics: string[];
    rationale: string;
  };

  type TResult = {
    reviewedAt: string;
    instructionPreview: string;
    topicCount: number;
    reviews: TReviewRecord[];
    topic_groups: TTopicGroup[];
    transfersProposed: number;
    approvedTransfersApplied: number;
  };

stages:
  - produceContextKeys: [missionText, reviews_acc, transfers_proposed_acc]
    logic: |
      const missionText = *load_task_mission(~/task-skills/task-mission/SKILL.md);
      const reviews_acc = [];
      const transfers_proposed_acc = 0;

  - nixeryRun: list-manager-topics
    nixeryInput:
      output: result.json
    logic: "(nixery)"

  - produceContextKeys: [topics, instructionPreview]
    logic: |
      Read ~/nixery/list-manager-topics/result.json from the session workspace.
      Parse the gate JSON. If ok and topics is an array, set topics to that array and instructionPreview to instructionPreview or ''.
      Otherwise set topics to [] and instructionPreview to ''.

  - loopSetup: for each topic of [topics]
    contextKeys: [missionText, topic, topics, reviews_acc, transfers_proposed_acc]
    updateContextKeys: [reviews_acc, transfers_proposed_acc]
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.7
      rubric: |
        Pass when topic is non-empty and reviews_acc gained a review whose topic matches this iteration,
        review.applyFailed is not true, and either review.skippedEmpty is true or
        ~/nixery/apply-manager-topic/apply-{topic}.json exists with ok: true and review.topic === topic.
        Fail (autoRetry) when apply was stopped, gate missing/ok:false, topic mismatch, or applyFailed.
    logic: |
      Read ~/task-skills/task-mission/SKILL.md.
      Read ~/task-skills/validate-and-feedback/SKILL.md.
      const intakeOut = 'intake-' + topic + '.json';
      /nixery(list-pending-observations, topic: topic, output: intakeOut);
      Read the gate JSON under ~/nixery/list-pending-observations/ named intakeOut from the session workspace.
      Parse the gate JSON. Set intake to intake object when ok; otherwise intake = { observations: [], needsValidation: [], depth: 'light', excerpts: {}, placePage: 'facts', topic }.
      const needs = intake.needsValidation || [];
      const obs = intake.observations || [];
      IF: needs.length > 0;
        const researchNeed = *validation_research_need(needs, topic, intake);
        const researchOut = 'research-' + topic + '.md';
        /nixery(
          research,
          topic: topic,
          need: researchNeed,
          mission: missionText,
          facts: { needs, excerpts: intake.excerpts },
          guidelinePath: ~/task-skills/validate-and-feedback/SKILL.md,
          output: researchOut,
        );
        Read the research markdown under ~/nixery/research/ named researchOut from the session workspace when present.
        const feedbacks = *build_validation_observations(needs, researchMd, topic);
        IF: feedbacks && feedbacks.length;
          for each feedback of feedbacks: /nixery(
            submit-knowledge-observation,
            topic_hint: topic,
            cue: feedback.cue,
            claim: feedback.claim,
            example: feedback.example,
            quote: feedback.quote,
            evidence: feedback.evidence,
            confidence: feedback.confidence,
            tags: feedback.tags,
          );
        END:
      END:
      IF: obs.length === 0 AND needs.length === 0 AND (intake.depth || 'light') === 'light';
        const review = { topic, depth: 'light', honeApplied: 0, honeSkipped: 0, opsApplied: 0, opsDiscarded: 0, quizTodoAdded: false, transfersProposed: 0, skippedEmpty: true };
        EXTENDS: reviews_acc = [...(reviews_acc || []), review];
      ELSE:
        const applyOut = 'apply-' + topic + '.json';
        /nixery(apply-manager-topic, topic: topic, output: applyOut);
        Read the apply gate under ~/nixery/apply-manager-topic/ named applyOut from the session workspace.
        Parse the gate JSON.
        IF: gate.ok AND gate.review AND gate.review.topic === topic;
          const review = gate.review;
          EXTENDS: reviews_acc = [...(reviews_acc || []), review];
          EXTENDS: transfers_proposed_acc = (transfers_proposed_acc || 0) + Number(review.transfersProposed || 0);
        ELSE:
          const review = { topic, depth: intake.depth || 'light', honeApplied: 0, honeSkipped: 0, opsApplied: 0, opsDiscarded: 0, quizTodoAdded: false, transfersProposed: 0, applyFailed: true };
          EXTENDS: reviews_acc = [...(reviews_acc || []), review];
        END:
      END:

  - nixeryRun: group-manager-topics
    nixeryInput:
      topics: topics
      output: result.json
    contextKeys: [topics]
    logic: "(nixery)"

  - produceContextKeys: [topic_groups]
    contextKeys: [topics]
    logic: |
      Read ~/nixery/group-manager-topics/result.json from the session workspace.
      Parse the gate JSON. If ok and topic_groups is an array, set topic_groups to that array.
      Otherwise set topic_groups to (topics || []).map(t => ({ id: 'solo-' + t, topics: [t], rationale: 'fallback singleton' })).

  - loopSetup: for each group of [topic_groups]
    contextKeys: [missionText, group, topic_groups, transfers_proposed_acc]
    updateContextKeys: [transfers_proposed_acc]
    verify:
      defId: stage-verify
      autoRetry: true
      minScore: 0.65
      rubric: |
        Pass when group.topics is a non-empty array and the stage only proposes knowledge_transfer
        (or skips when group has fewer than 2 topics). Fail if narrative wiki was upserted on a target topic.
    logic: |
      Read ~/task-skills/task-mission/SKILL.md.
      Read ~/task-skills/cross-topic-scan/SKILL.md.
      IF: group && group.topics && group.topics.length >= 2;
        const briefs = *load_group_briefs(group.topics);
        const candidates = *find_cross_topic_candidates(briefs, group, guideline: ~/task-skills/cross-topic-scan/SKILL.md);
        IF: candidates && candidates.length;
          for each candidate of candidates: /mastermind(
            propose-knowledge-transfer,
            sourceTopic: candidate.sourceTopic,
            targetTopic: candidate.targetTopic,
            claim: candidate.claim,
            rationale: candidate.rationale,
            example: candidate.example,
            evidence: candidate.evidence,
          );
          EXTENDS: transfers_proposed_acc = (transfers_proposed_acc || 0) + candidates.length;
        END:
      END:

  - nixeryRun: apply-approved-transfers
    nixeryInput:
      output: result.json
    logic: "(nixery)"

  - produceContextKeys: [result]
    contextKeys: [instructionPreview, topics, reviews_acc, topic_groups, transfers_proposed_acc]
    logic: |
      Read ~/nixery/apply-approved-transfers/result.json from the session workspace.
      Parse the gate JSON. Set approvedTransfersApplied to approvedTransfersApplied number or 0.
      const result = {
        reviewedAt: new Date().toISOString(),
        instructionPreview: instructionPreview || '',
        topicCount: (topics || []).length,
        reviews: reviews_acc || [],
        topic_groups: topic_groups || [],
        transfersProposed: transfers_proposed_acc || 0,
        approvedTransfersApplied,
      };
