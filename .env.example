# Absolute path to this repo (project-yahl) on the host; required for agent workspace bind mounts.
HOST_REPO_ROOT=

# Docker full stack (`pnpm run compose:up:all`): server bind-mounts ./server/tasks so web task CRUD persists on the host (git-tracked).

# Optional: path to .env for agent compose env_file (default `.env` relative to repo root).
# COMPOSE_ENV_FILE=.env

# Optional: Omniflex monorepo root for agent image build (default `..` relative to project-yahl).
# OMNIFLEX_BUILD_CONTEXT=

# Omniflex app folder name under monorepo root (default project-yahl).
# OMNIFLEX_APP_DIR=project-yahl

SHARED_DOCKER_NETWORK=yahl_shared

# Cursor API key — required for mastermind SDK skills and worker verify CLI (worker exits on startup without it)
CURSOR_API_KEY=

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_MODE=disabled

# With OneCLI: leave LLM_API_KEY empty or placeholder; orchestrator injects proxy env into agent.
# Stagehand auto-prefixes LLM_MODEL to openai/<model> unless overridden:
# STAGEHAND_MODEL=deepseek/deepseek-chat

# Dev only: headed browser + per-session VNC (Docker assigns host port; see session web UI Live view menu)
# STAGEHAND_LIVEVIEW=1

ONECLI_DASHBOARD_URL=http://127.0.0.1:10254
ONECLI_API_KEY=
# Docker server stack overrides ONECLI_DASHBOARD_URL to http://onecli:10254

MONGODB_URI=mongodb://127.0.0.1:27017/yahl
REDIS_URL=redis://127.0.0.1:6379
# Agent container must use Docker Redis, not host REDIS_URL:
AGENT_REDIS_URL=redis://redis:6379
SESSION_API_BASE_URL=http://127.0.0.1:4000

# Agent container → mastermind (fixed in docker-compose.agent.yml as http://mastermind:4100).
# Host orchestrator → put MASTERMIND_API_URL=http://127.0.0.1:4100 in runtime/.env instead.
MASTERMIND_API_URL=http://mastermind:4100
# Orchestrator verify gate → worker HTTP API (file context + agent --yolo CLI)
WORKER_API_URL=http://worker:4200
# Worker verify rubric files (default /data in container = ./data/mastermind)
# VERIFY_RULES_ROOT=/data
# Docker stack: shared session files at /workspace in server, mastermind, worker, agent containers
# WORKSPACE_ROOT=/workspace
# Host-side orchestrator (runtime/.env): absolute path to repo data/workspace
# Optional: shared secret for GET /v1/internal/self-check from host-side doctor
# MASTERMIND_INTERNAL_TOKEN=
# Log Cursor SDK run.stream() events during skill prompts (verbose; default off)
# MASTERMIND_SDK_STREAM_LOG=1

# Worker knowledges tidy cron (default dry-run true until KNOWLEDGE_TIDY_DRY_RUN=false)
# KNOWLEDGE_TIDY_DRY_RUN=true

# Worker health probe (default 4200)
# WORKER_HEALTH_URL=http://127.0.0.1:4200

# Worker outbound channels (v1 log-only stubs even when set):
# SMTP_HOST=
# WHATSAPP_API_TOKEN=

# Legacy aliases are still supported:
# DEEPSEEK_API_KEY=
# DEEPSEEK_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_THINKING_MODE=disabled
