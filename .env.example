# Absolute path to this repo (project-yahl) on the host; required for agent workspace bind mounts.
HOST_REPO_ROOT=

# Docker full stack (`pnpm run compose:up:all`): server bind-mounts ./server/tasks so web task CRUD persists on the host (git-tracked).

# Optional: path to .env for agent compose env_file (default `.env` relative to repo root).
# COMPOSE_ENV_FILE=.env

# Optional: Omniflex monorepo root for agent image build (default `..` relative to project-yahl).
# OMNIFLEX_BUILD_CONTEXT=

# Omniflex app folder name under monorepo root (default project-yahl).
# OMNIFLEX_APP_DIR=project-yahl

SHARED_DOCKER_NETWORK=yahl_shared

# Container timezone for all docker-compose services (mongo, redis, server, web, worker, …)
TZ=Asia/Hong_Kong

LLM_API_KEY=
# Callers hit llm-proxy (OpenAI-compatible). Provider host is LLM_PROVIDER_DOMAIN (x-domain).
# Provider keys are injected by OneCLI from domain — do not put them on llm-proxy or callers.
LLM_BASE_URL=http://llm-proxy:4100/v1
LLM_PROVIDER_DOMAIN=api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_MODE=disabled
# Shared token for caller → llm-proxy (header X-Llm-Proxy-Token). Empty = chat rejected.
LLM_PROXY_TOKEN=
# llm-proxy owns per-call retries (default 3 attempts, 60s × 1.1). Callers may override via x-llm-retry-max (>=0).
# LLM_CALL_RETRY_MAX=3
# LLM_PROXY_PORT=4100

# Nixery: copy .env.nixery.example → .env.nixery (loaded at orchestrator startup after .env).
# Empty keys in server/nixery/*/index.yml inherit the same-named process.env var.

# With OneCLI: leave LLM_API_KEY empty; llm-proxy uses HTTPS_PROXY so OneCLI injects the provider key.
# Stagehand auto-prefixes LLM_MODEL to openai/<model> unless overridden.
# Stagehand LLM calls go to a localhost-only shim in the agent (brief merge), then nest to llm-proxy.
# STAGEHAND_MODEL=deepseek/deepseek-chat
# Optional fixed port for the shim (default: ephemeral on 127.0.0.1):
# STAGEHAND_LLM_PROXY_PORT=0

# Dev only: headed browser + per-session VNC (Docker assigns host port; see session web UI Live view menu)
# STAGEHAND_LIVEVIEW=1

ONECLI_DASHBOARD_URL=http://127.0.0.1:10254
ONECLI_API_KEY=
# Docker server stack overrides ONECLI_DASHBOARD_URL to http://onecli:10254

MONGODB_URI=mongodb://127.0.0.1:27017/yahl
REDIS_URL=redis://127.0.0.1:6379
# Agent container must use Docker Redis, not host REDIS_URL:
AGENT_REDIS_URL=redis://redis:6379
# Shared fallback max milliseconds for each run_bash when stage omits agentOverrides.bashTimeoutMs (default 60000).
# Prefer per-stage YAML: agentOverrides.bashTimeoutMs (e.g. 360000 on traffic_monitor monitor).
# AGENT_BASH_TIMEOUT_MS=60000
SESSION_API_BASE_URL=http://127.0.0.1:4000

# Agent container → session server (docker-compose.agent.yml default host.docker.internal:4000).
# Override for full docker stack: AGENT_SESSION_API_BASE_URL=http://server:4000
# AGENT_SESSION_API_BASE_URL=http://host.docker.internal:4000
# Docker stack: shared session files at /workspace in server, worker, agent containers
# WORKSPACE_ROOT=/workspace
# Host-side orchestrator (runtime/.env): absolute path to repo data/workspace
# Required for human approve at /platform/approvals and KM instruction PUT (header X-Approval-Token). Empty = approve/save disabled.
# PLATFORM_APPROVAL_TOKEN=
# Worker → server internal routes (WhatsApp QR/status). Empty = worker skips channel API updates.
# WORKER_INTERNAL_TOKEN=
# Control plane → tenant quota + usage poll (SaaS). Empty = internal routes reject.
# CONTROL_PLANE_SERVICE_TOKEN=
# SaaS quota state file (tenant droplet). When set, server + llm-proxy read quota from JSON file.
# QUOTA_STATE_FILE=./data/quota/state.json
# Server knowledge data root (topics.json + knowledge-manager-instruction.md); default HOST_REPO_ROOT/data/mastermind
# KNOWLEDGE_DATA_ROOT=

# Wiki.js knowledge store (required for get-knowledge / upsert-knowledge-page)
# Configure Admin → Storage → Local File System, Push to target, path /wiki/data/repo
WIKI_API_TOKEN=
WIKI_PORT=3001
WIKI_PUBLIC_URL=http://127.0.0.1:3001
# CODE_SERVER_PORT=8080
# WIKI_GRAPHQL_URL=http://wiki:3000/graphql
# KNOWLEDGE_EXPORT_ROOT=/data/knowledge_export   # Local FS export root
# WIKI_DB_PASSWORD=wikijs
# WIKI_EXPORT_PAGE_THRESHOLD=10
# WIKI_EXPORT_BYTES_THRESHOLD=262144

# Worker outbound channels (Gmail SMTP defaults):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
# SYSTEM_ADMIN_EMAIL=admin@example.com
# EMAIL_WHITELIST=ops@example.com,alerts@example.com
# WhatsApp Web (whatsapp-web.js in worker). Scan QR in worker console on first login.
# WHATSAPP_ENABLED=true
# WHATSAPP_WHITELIST=91234567,+85298765432
# WHATSAPP_INBOX_ROOT=/whatsapp/inbox
# WHATSAPP_AUTH_PATH=/whatsapp/auth
# Optional host path for channel message sanitizer (mounted into worker at /sanitize/sanitize-channel-message.mjs)
# SANITIZE_CHANNEL_MESSAGE=./worker/sanitize-channel-message.mjs
