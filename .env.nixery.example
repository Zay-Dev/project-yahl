# Copy to .env.nixery. Loaded by the orchestrator at startup (config.ts) after .env.
# Empty keys in server/nixery/*/index.yml inherit the same-named process.env value.
# ${VAR} expands from process.env (main .env already loaded).

OPENAI_BASE_URL=${LLM_BASE_URL}
OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_BASE_URL_PLAN=${LLM_BASE_URL}
OPENAI_BASE_URL_EXECUTE=${LLM_BASE_URL}
OPENAI_BASE_URL_REVIEW=${LLM_BASE_URL}
