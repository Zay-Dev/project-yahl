# Copy to .env.nixery. Loaded by the orchestrator at startup (config.ts) after .env.
# Empty keys in server/nixery/*/index.yml inherit the same-named process.env value.
# ${VAR} expands from process.env (main .env already loaded).

OPENAI_BASE_URL=http://llm-proxy:4100/v1
OPENAI_API_KEY=${LLM_API_KEY}
OPENAI_PROVIDER_DOMAIN=${LLM_PROVIDER_DOMAIN}
LLM_PROXY_TOKEN=${LLM_PROXY_TOKEN}
OPENAI_BASE_URL_PLAN=http://llm-proxy:4100/v1
OPENAI_BASE_URL_EXECUTE=http://llm-proxy:4100/v1
OPENAI_BASE_URL_REVIEW=http://llm-proxy:4100/v1
OPENAI_PROVIDER_DOMAIN_PLAN=${LLM_PROVIDER_DOMAIN}
OPENAI_PROVIDER_DOMAIN_EXECUTE=${LLM_PROVIDER_DOMAIN}
OPENAI_PROVIDER_DOMAIN_REVIEW=${LLM_PROVIDER_DOMAIN}
