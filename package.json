{
  "name": "project-yahl-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "pnpm --filter ./server --filter ./shared --filter ./runtime --filter ./web --filter ./worker --filter ./llm-proxy build",
    "build:shared": "pnpm --filter @project-yahl/shared build",
    "compose:down": "docker compose down",
    "compose:up": "docker compose up -d mongo redis onecli onecli_postgres wiki_postgres wiki code-server worker llm-proxy",
    "compose:up:all": "docker compose up -d --build mongo redis onecli onecli_postgres wiki_postgres wiki code-server server web worker llm-proxy",
    "dev": "pnpm -r --parallel --filter @project-yahl/runtime --filter @project-yahl/server run dev",
    "dev:llm-proxy": "pnpm --filter @project-yahl/llm-proxy run dev",
    "dev:runtime": "pnpm --filter @project-yahl/runtime run dev",
    "dev:server": "pnpm --filter @project-yahl/server run dev",
    "dev:web": "pnpm --filter web run dev",
    "nixery:link": "pnpm --filter @project-yahl/shared run build && node shared/nixery/nixery-link.mjs",
    "orchestrate": "pnpm --filter runtime run orchestrate",
    "test": "pnpm --filter runtime run test",
    "test:server": "pnpm --filter @project-yahl/server run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0"
}