name: competitor-intel
description: Competitor intelligence brief

types: |
  type TIntelItem = {
    title: string;
    source_url: string;
    date: Date;
    competitor: string;
    category: 'product_launch' | 'pricing_change' | 'partnership' | 'funding' | 'other';
    sentiment: 'positive' | 'neutral' | 'negative';
    summary_zh: string;
  };

  type TBriefTakeaway = {
    text_zh: string;
  };

  type TBriefSection = {
    heading: string;
    body_md: string<Markdown>;
  };

  type TResult = {
    executive_summary_md: string<Markdown>;
    generated_at: string<Date>;
    raw_intel: TIntelItem[];
    sections: TBriefSection[];
    takeaways: TBriefTakeaway[];
    title: string;
  };

stages:
  - contextMode: true
    logic: |
      (() => ({
        competitors: [
          { name: 'TESLA', news_sources: ['yahoo news', 'bbc', 'reddit',] },
          { name: 'XiaoMi', news_sources: ['bloomberg', 'techinasia'] },
          { name: 'BYD', news_sources: ['yahoo news', 'bloomberg'] },
        ],
        intel: [],
      }))

  - logic: |
      *aware_echo('I understand I need to set the tools\' path to context keys "search_tool" and "extract_intel_tool" separately')

      const search_tool = *get_or_create_python_tool(
        dir: ~/tools,
        skill: /web-search,
        query: 'xxx news last 7 days',
        args: {multiple_sources_name}
        max_results: 10,
        filter: business_relevant,
        requirements: [always_accept_multiple_sources_at_once]
      );

      const extract_intel_tool = *get_or_create_python_tool(
        dir: ~/tools,
        input: output_of_search_tool,
        output: flat_mapped(TIntelItem),
        set_competitor: {competitor.name},
        categorize: true,
        sentiment_analysis: true,
        requirements: [leave_summary_zh_empty]
      );

  - loopSetup: for each competitor of [competitors]
    logic: |
      *aware_echo('I understand I do not need to call set_context for raw_articles');
      *aware_echo('I understand the api key is placeholder and still work');

      raw_articles = *invoke(search_tool, competitor.news_sources, all_sources_at once, fallback: curl_to_file);

      *aware_echo('I understand set_context writes runtime context outside the sandbox, so I will not self-validate writeback in-run');
      *aware_echo('I understand the set_context key is intel instead of result');
      *aware_echo('I also understand the summary language is zh-TW');
      EXTENDS: intel = *invoke(
        extract_intel_tool,
        competitor.name,
        requirements: [fill_summary_zh],
      );

      *improve_or_add_remark([search_tool, extract_intel_tool]);

  - logic: |
      *aware_echo('I understand set_context writes runtime context outside the sandbox, so I will not self-validate writeback in-run');
      *aware_echo('I understand the set_context key is intel instead of result');
      *aware_echo('I also understand I will need to flat the intel to TIntelItem');

      *get_or_create_python_tool(
        quality_check & deduplicate_and_sort,
        this.intel,
        ensure_completeness,
        remove_empty_summaries,
        sort: date_desc
      );

  - logic: |
      *aware_echo('I understand set_context writes runtime context outside the sandbox, so I will not self-validate writeback in-run');
      *aware_echo('I understand set_context keys are title, executive_summary_md, takeaways, sections, intel — not result');
      *aware_echo('I also understand the brief language is zh-TW and takeaway lines stay short for list_cards');
      const title = *summary(concise_title, lang: zh-TW);
      const executive_summary_md = *generate_brief(
        this.intel,
        format: markdown,
        role: executive_overview,
        tone: professional,
        lang: zh-TW,
      );
      const takeaways = *generate_brief(
        this.intel,
        as: TBriefTakeaway[],
        include_key_takeaways: true,
        lang: zh-TW,
        max_items: 12,
      );
      const sections = *generate_brief(
        this.intel,
        as: TBriefSection[],
        format: markdown,
        include_toc: true,
        lang: zh-TW,
      );

  - contextMode: true
    logic: |
      (() => ({
        result: {
          executive_summary_md: context.context.executive_summary_md,
          generated_at: new Date().toISOString(),
          raw_intel: context.context.intel,
          sections: context.context.sections,
          takeaways: context.context.takeaways,
          title: context.context.title,
        }
      }));
