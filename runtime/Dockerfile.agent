FROM node:22

ARG OMNIFLEX_APP_DIR=project-yahl
ARG PLAYWRIGHT_VERSION=1.60.0

WORKDIR /omniflex

RUN corepack enable

RUN apt-get update \
  && apt-get install -y --no-install-recommends xvfb x11vnc \
  && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

RUN npx playwright@${PLAYWRIGHT_VERSION} install-deps chromium \
  && npx playwright@${PLAYWRIGHT_VERSION} install chromium

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY ${OMNIFLEX_APP_DIR}/package.json ./${OMNIFLEX_APP_DIR}/
COPY ${OMNIFLEX_APP_DIR}/shared/package.json ./${OMNIFLEX_APP_DIR}/shared/
COPY ${OMNIFLEX_APP_DIR}/runtime/package.json ./${OMNIFLEX_APP_DIR}/runtime/

RUN pnpm install --frozen-lockfile --filter @project-yahl/runtime...

COPY ${OMNIFLEX_APP_DIR}/shared ./${OMNIFLEX_APP_DIR}/shared

WORKDIR /omniflex/${OMNIFLEX_APP_DIR}/runtime

COPY ${OMNIFLEX_APP_DIR}/runtime/agent ./agent
COPY ${OMNIFLEX_APP_DIR}/runtime/orchestrator ./orchestrator
COPY ${OMNIFLEX_APP_DIR}/runtime/shared ./shared
COPY ${OMNIFLEX_APP_DIR}/runtime/tsconfig.json ./tsconfig.json

RUN node ./agent/resolve-chrome-path.cjs > /opt/chrome-path

RUN chmod +x agent/docker-entrypoint.sh

ENTRYPOINT ["./agent/docker-entrypoint.sh"]
CMD ["pnpm", "--silent", "--filter", "@project-yahl/runtime", "run", "agent", "--", "--daemon"]
