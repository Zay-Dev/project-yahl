FROM node:22

WORKDIR /omniflex

RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY project-yahl/package.json ./project-yahl/
COPY project-yahl/runtime/package.json ./project-yahl/runtime/

RUN pnpm install --frozen-lockfile --filter @project-yahl/runtime...

COPY project-yahl/runtime/agent ./project-yahl/runtime/agent
COPY project-yahl/runtime/orchestrator ./project-yahl/runtime/orchestrator
COPY project-yahl/runtime/shared ./project-yahl/runtime/shared
COPY project-yahl/runtime/tsconfig.json ./project-yahl/runtime/tsconfig.json

WORKDIR /omniflex/project-yahl/runtime

CMD ["pnpm", "--silent", "--filter", "@project-yahl/runtime", "run", "agent", "--", "--daemon"]
